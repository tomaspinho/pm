package views

import (
	"fmt"

	"pm/internal/model"
)

// SearchResultsPage displays full search results
templ SearchResultsPage(query string, tasks []model.TaskSearchResult, nav NavContext) {
	@AuthLayout("Search: " + query, nav) {
		<div class="p-2">
			<div class="mb-6">
				<h1 class="text-2xl font-bold text-gray-900 mb-2">Search Results for "{ query }"</h1>
				<p class="text-sm text-gray-500">{ fmt.Sprintf("%d result%s found", len(tasks), pluralize(len(tasks))) }</p>
			</div>
			
			if len(tasks) == 0 {
				<div class="text-center py-16">
					<div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-4">
						<svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
					<p class="text-gray-600 mb-4">No tasks found matching "{ query }"</p>
					<p class="text-sm text-gray-500">Try adjusting your search terms or check your spelling</p>
				</div>
			} else {
				<div class="space-y-3">
					for _, task := range tasks {
						<a 
							href={ fmt.Sprintf("/orgs/%d/projects/%d/tasks/%d", nav.CurrentOrgID, task.ProjectID, task.ID) }
							class="block bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md hover:border-indigo-300 transition-all cursor-pointer"
							target="_blank"
							rel="noopener noreferrer"
						>
							<div class="flex items-start gap-3">
								<div class="flex-shrink-0 mt-0.5">
									<span class="w-3 h-3 rounded-full inline-block" style={ "background-color: " + task.ColumnColor } title={ task.ColumnName }></span>
								</div>
								<div class="flex-1 min-w-0">
									<h3 class="text-lg font-medium text-gray-900 mb-1 truncate">{ task.Title }</h3>
									if task.Description != "" {
										<p class="text-sm text-gray-600 line-clamp-2 mb-2">{ task.Description }</p>
									}
									<div class="flex items-center gap-2 text-xs text-gray-500">
										<span>{ task.ProjectName }</span>
										<span>•</span>
										<span>{ task.ColumnName }</span>
										if task.Author != "" {
											<span>•</span>
											<span>by { task.Author }</span>
										}
									</div>
								</div>
								<div class="flex-shrink-0">
									<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
									</svg>
								</div>
							</div>
						</a>
					}
				</div>
			}
		</div>
	}
}

// Helper function to pluralize words
func pluralize(count int) string {
	if count == 1 {
		return ""
	}
	return "s"
}