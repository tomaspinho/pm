package views

import (
	"fmt"

	"cracked-pm/internal/model"
)

templ ProjectPickerPage(user *model.User, orgs []model.Organization, currentOrg *model.Organization, projects []model.Project) {
	@Layout("Projects") {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold text-gray-900">Projects</h1>
				if currentOrg != nil {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/new", currentOrg.ID)) }
						class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors"
					>
						New Project
					</a>
				}
			</div>
			<!-- Organization Picker -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Organization</label>
				<div class="flex gap-2 flex-wrap">
					for _, org := range orgs {
						if currentOrg != nil && org.ID == currentOrg.ID {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/projects?org_id=%d", org.ID)) }
								class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg"
							>
								{ org.Name }
							</a>
						} else {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/projects?org_id=%d", org.ID)) }
								class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
							>
								{ org.Name }
							</a>
						}
					}
				</div>
			</div>
			<!-- Project List -->
			if currentOrg == nil {
				<div class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center">
					<p class="text-gray-500">Select an organization above to view its projects.</p>
				</div>
			} else if len(projects) == 0 {
				<div class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center space-y-2">
					<p class="text-gray-500">No projects yet in { currentOrg.Name }.</p>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/new", currentOrg.ID)) }
						class="inline-block px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors"
					>
						Create your first project
					</a>
				</div>
			} else {
				<div class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-200">
					for _, project := range projects {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d", currentOrg.ID, project.ID)) }
							class="block px-4 py-3 hover:bg-gray-50 transition-colors"
						>
							<p class="text-sm font-medium text-gray-900">{ project.Name }</p>
							if project.Description != "" {
								<p class="text-xs text-gray-500 mt-0.5">{ project.Description }</p>
							}
						</a>
					}
				</div>
			}
		</div>
	}
}

templ NewProjectPage(orgID int64) {
	@Layout("New Project") {
		<div class="flex justify-center py-8">
			<div class="w-full max-w-md">
				<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-6">
					<h1 class="text-2xl font-bold text-gray-900">New Project</h1>
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects", orgID)) } class="space-y-4">
						<div class="space-y-1">
							<label for="name" class="block text-sm font-medium text-gray-700">Project Name</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								autofocus
								placeholder="My Project"
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
							/>
						</div>
						<div class="space-y-1">
							<label for="description" class="block text-sm font-medium text-gray-700">Description (optional)</label>
							<textarea
								id="description"
								name="description"
								rows="3"
								placeholder="What is this project about?"
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm resize-none"
							></textarea>
						</div>
						<div class="flex gap-2">
							<button
								type="submit"
								class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors"
							>
								Create Project
							</button>
							<a
								href={ templ.SafeURL(fmt.Sprintf("/projects?org_id=%d", orgID)) }
								class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
							>
								Cancel
							</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}
