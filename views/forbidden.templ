package views

templ ForbiddenPage() {
	@Layout("Forbidden") {
		<div class="flex justify-center py-8">
			<div class="w-full max-w-md text-center space-y-4">
				<div class="text-6xl text-gray-300 font-bold">403</div>
				<h1 class="text-2xl font-bold text-gray-900">Access Denied</h1>
				<p class="text-gray-500">You don't have permission to access this resource.</p>
				<a
					href="/"
					class="inline-block px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors"
				>
					Go to Projects
				</a>
			</div>
		</div>
	}
}
