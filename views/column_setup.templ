package views

import (
	"fmt"

	"pm/internal/model"
)

templ ColumnSetupPage(project model.Project, orgID int64, existingColumns []model.ProjectColumn, nav NavContext) {
	@AuthLayout("Set Up Columns", nav) {
		<div class="flex justify-center py-8">
			<div class="w-full max-w-2xl">
				<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-6">
					<!-- Header -->
					<div class="space-y-2">
						<h1 class="text-2xl font-bold text-gray-900">Set Up Columns</h1>
						<p class="text-sm text-gray-600">
							Configure workflow columns for <span class="font-medium">{ project.Name }</span>
						</p>
					</div>
					if len(existingColumns) > 0 {
						<!-- Already configured message -->
						<div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
							<p class="text-sm text-blue-800">
								Columns are already configured for this project.
								<a href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d", orgID, project.ID)) } class="font-medium underline hover:text-blue-900">
									Go to board
								</a>
							</p>
						</div>
					} else {
						<!-- Column Setup Form -->
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d/columns/setup", orgID, project.ID)) } id="column-form" class="space-y-4">
							<div class="space-y-1">
								<label class="block text-sm font-medium text-gray-700">Columns</label>
								<p class="text-xs text-gray-500">Add, remove, or customize columns for your project workflow</p>
							</div>
							<!-- Columns Container -->
							<div id="columns-container" class="space-y-2">
								<!-- Default columns will be rendered by JavaScript -->
							</div>
							<!-- Add Column Button -->
							<button
								type="button"
								id="add-column-btn"
								class="w-full px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors border border-gray-300 border-dashed"
							>
								+ Add Column
							</button>
							<!-- Actions -->
							<div class="flex gap-2 pt-4 border-t border-gray-200">
								<button
									type="submit"
									class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors"
								>
									Save & Continue
								</button>
								<a
									href={ templ.SafeURL(fmt.Sprintf("/projects?org_id=%d", orgID)) }
									class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
								>
									Cancel
								</a>
							</div>
						</form>
					}
				</div>
			</div>
		</div>
		<!-- Column Setup Script -->
		@columnSetupScript()
	}
}

templ columnSetupScript() {
	<script type="text/javascript">
	(function() {
		var defaultColumns = [
			{ name: 'To Do', color: '#6B7280' },
			{ name: 'In Progress', color: '#3B82F6' },
			{ name: 'Done', color: '#10B981' }
		];

		var colors = ['#6B7280', '#EF4444', '#F59E0B', '#10B981', '#3B82F6', '#8B5CF6', '#EC4899', '#14B8A6'];
		var columnIndex = 0;

		function createColumnRow(name, color) {
			name = name || '';
			color = color || '#6B7280';
			var index = columnIndex++;
			var row = document.createElement('div');
			row.className = 'flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200';
			row.innerHTML = '<div class="flex-shrink-0 w-8 h-8 cursor-move drag-handle flex items-center justify-center text-gray-400 hover:text-gray-600">' +
				'<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
				'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg></div>' +
				'<div class="flex-shrink-0"><div class="w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: ' + color + ';" data-color="' + color + '"></div></div>' +
				'<input type="text" name="columns[' + index + '][name]" value="' + name + '" placeholder="Column name" required ' +
				'class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />' +
				'<input type="hidden" name="columns[' + index + '][color]" value="' + color + '" />' +
				'<button type="button" class="color-picker-btn flex-shrink-0 px-3 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">Color</button>' +
				'<button type="button" class="delete-column-btn flex-shrink-0 px-3 py-2 text-xs font-medium text-red-600 bg-white border border-red-300 rounded-lg hover:bg-red-50 transition-colors">Delete</button>';
			return row;
		}

		function createColorPicker(currentColor, onSelect) {
			var modal = document.createElement('div');
			modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
			var colorButtons = colors.map(function(color) {
				var isSelected = color === currentColor;
				return '<button type="button" class="color-option w-12 h-12 rounded-lg border-2 ' +
					(isSelected ? 'border-indigo-600 ring-2 ring-indigo-200' : 'border-gray-300 hover:border-gray-400') +
					' transition-all" style="background-color: ' + color + ';" data-color="' + color + '"></button>';
			}).join('');
			
			modal.innerHTML = '<div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full mx-4">' +
				'<h3 class="text-lg font-semibold text-gray-900 mb-4">Choose Color</h3>' +
				'<div class="grid grid-cols-4 gap-3">' + colorButtons + '</div>' +
				'<div class="mt-6 flex justify-end">' +
				'<button type="button" class="cancel-picker px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>' +
				'</div></div>';

			modal.querySelectorAll('.color-option').forEach(function(btn) {
				btn.addEventListener('click', function() {
					var selectedColor = btn.dataset.color;
					onSelect(selectedColor);
					modal.remove();
				});
			});

			modal.querySelector('.cancel-picker').addEventListener('click', function() {
				modal.remove();
			});

			modal.addEventListener('click', function(e) {
				if (e.target === modal) {
					modal.remove();
				}
			});

			return modal;
		}

		function addColumn(name, color) {
			name = name || '';
			color = color || '#6B7280';
			var container = document.getElementById('columns-container');
			var row = createColumnRow(name, color);

			row.querySelector('.delete-column-btn').addEventListener('click', function() {
				row.remove();
				reindexColumns();
			});

			row.querySelector('.color-picker-btn').addEventListener('click', function() {
				var colorDot = row.querySelector('[data-color]');
				var colorInput = row.querySelector('input[type="hidden"]');
				var currentColor = colorInput.value;

				var picker = createColorPicker(currentColor, function(newColor) {
					colorDot.style.backgroundColor = newColor;
					colorDot.dataset.color = newColor;
					colorInput.value = newColor;
				});

				document.body.appendChild(picker);
			});

			container.appendChild(row);
		}

		function reindexColumns() {
			var container = document.getElementById('columns-container');
			var rows = container.querySelectorAll('.flex.items-center.gap-2');
			rows.forEach(function(row, index) {
				var nameInput = row.querySelector('input[type="text"]');
				var colorInput = row.querySelector('input[type="hidden"]');
				nameInput.name = 'columns[' + index + '][name]';
				colorInput.name = 'columns[' + index + '][color]';
			});
			columnIndex = rows.length;
		}

		document.addEventListener('DOMContentLoaded', function() {
			defaultColumns.forEach(function(col) {
				addColumn(col.name, col.color);
			});

			document.getElementById('add-column-btn').addEventListener('click', function() {
				addColumn();
			});

			document.getElementById('column-form').addEventListener('submit', function(e) {
				reindexColumns();
				var container = document.getElementById('columns-container');
				if (container.children.length === 0) {
					e.preventDefault();
					alert('At least one column is required');
				}
			});
		});
	})();
	</script>
}
