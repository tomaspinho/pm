package views

import (
	"fmt"

	"pm/internal/model"
)

// NavContext holds data for the navigation bar. Nil means not authenticated.
type NavContext struct {
	User         *model.User
	Orgs         []model.Organization
	CurrentOrgID int64
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - pm</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/Sortable.min.js"></script>
		</head>
		<body class="bg-gray-50 text-gray-900 min-h-screen">
			<nav class="bg-white shadow-sm border-b border-gray-200">
				<div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
					<a href="/" class="text-lg font-semibold text-gray-800">pm</a>
				</div>
			</nav>
			<main class="max-w-7xl mx-auto px-4 py-8">
				{ children... }
			</main>
			<div id="modal-container"></div>
			@confirmModalScript()
		</body>
	</html>
}

templ AuthLayout(title string, nav NavContext) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - pm</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/Sortable.min.js"></script>
		</head>
		<body class="bg-gray-50 text-gray-900 min-h-screen">
			<nav class="bg-white shadow-sm border-b border-gray-200">
				<div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
					<a href="/" class="text-lg font-semibold text-gray-800">pm</a>
					<div class="flex items-center gap-4">
						<!-- Org Picker -->
						if len(nav.Orgs) > 0 {
							<div class="relative">
								<select
									class="text-sm border border-gray-300 rounded-lg px-3 py-1.5 bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer"
									onchange="window.location.href='/projects?org_id='+this.value"
								>
									<option value="">Select organization</option>
									for _, org := range nav.Orgs {
										if org.ID == nav.CurrentOrgID {
											<option value={ fmt.Sprintf("%d", org.ID) } selected>{ org.Name }</option>
										} else {
											<option value={ fmt.Sprintf("%d", org.ID) }>{ org.Name }</option>
										}
									}
								</select>
							</div>
						}
						<!-- User info + Logout -->
						<div class="flex items-center gap-3">
							<span class="text-sm text-gray-500">{ nav.User.Email }</span>
							<form method="POST" action="/logout">
								<button
									type="submit"
									class="text-sm text-gray-500 hover:text-gray-700 transition-colors cursor-pointer"
								>
									Sign out
								</button>
							</form>
						</div>
					</div>
				</div>
			</nav>
			<main class="max-w-7xl mx-auto px-4 py-8">
				{ children... }
			</main>
			<div id="modal-container"></div>
			@confirmModalScript()
		</body>
	</html>
}

templ BoardLayout(title string, nav NavContext) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - pm</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/Sortable.min.js"></script>
		</head>
		<body class="bg-gray-50 text-gray-900 min-h-screen">
			<nav class="bg-white shadow-sm border-b border-gray-200">
				<div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
					<a href="/" class="text-lg font-semibold text-gray-800">pm</a>
					<div class="flex items-center gap-4">
						<!-- Org Picker -->
						if len(nav.Orgs) > 0 {
							<div class="relative">
								<select
									class="text-sm border border-gray-300 rounded-lg px-3 py-1.5 bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer"
									onchange="window.location.href='/projects?org_id='+this.value"
								>
									<option value="">Select organization</option>
									for _, org := range nav.Orgs {
										if org.ID == nav.CurrentOrgID {
											<option value={ fmt.Sprintf("%d", org.ID) } selected>{ org.Name }</option>
										} else {
											<option value={ fmt.Sprintf("%d", org.ID) }>{ org.Name }</option>
										}
									}
								</select>
							</div>
						}
						<!-- User info + Logout -->
						<div class="flex items-center gap-3">
							<span class="text-sm text-gray-500">{ nav.User.Email }</span>
							<form method="POST" action="/logout">
								<button
									type="submit"
									class="text-sm text-gray-500 hover:text-gray-700 transition-colors cursor-pointer"
								>
									Sign out
								</button>
							</form>
						</div>
					</div>
				</div>
			</nav>
			<main class="py-8">
				{ children... }
			</main>
			<div id="modal-container"></div>
			@confirmModalScript()
		</body>
	</html>
}

templ confirmModalScript() {
	<script>
	(function() {
		document.body.addEventListener('htmx:confirm', function(evt) {
			// Task delete confirmation
			if (evt.target.hasAttribute('data-confirm-delete')) {
				evt.preventDefault();
				
				var modal = document.getElementById('modal-container');
				
				// Create modal HTML
				modal.innerHTML = `
					<div class="modal-backdrop fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
						<div class="modal-card bg-white rounded-lg shadow-xl max-w-md w-full p-6 space-y-4">
							<div class="flex items-start gap-3">
								<div class="shrink-0 w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
									<svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
									</svg>
								</div>
								<div class="flex-1">
									<h3 class="text-lg font-semibold text-gray-900">Delete Task</h3>
									<p class="mt-1 text-sm text-gray-500">Are you sure you want to delete this task? This action cannot be undone.</p>
								</div>
							</div>
							<div class="flex gap-3 justify-end">
								<button type="button" class="btn-cancel px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
									Cancel
								</button>
								<button type="button" class="btn-delete px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors">
									Delete
								</button>
							</div>
						</div>
					</div>
				`;
				
				// Handle delete confirmation
				modal.querySelector('.btn-delete').onclick = function() {
					modal.innerHTML = '';
					evt.detail.issueRequest();
				};
				
				// Handle cancel
				modal.querySelector('.btn-cancel').onclick = function() {
					modal.innerHTML = '';
				};
				
				// Close on backdrop click
				modal.querySelector('.modal-backdrop').onclick = function(e) {
					if (e.target === e.currentTarget) {
						modal.innerHTML = '';
					}
				};
				
				// Close on Escape key
				function handleEscape(e) {
					if (e.key === 'Escape') {
						modal.innerHTML = '';
						document.removeEventListener('keydown', handleEscape);
					}
				}
				document.addEventListener('keydown', handleEscape);
			}
			
			// Comment delete confirmation
			if (evt.target.hasAttribute('data-confirm-delete-comment')) {
				evt.preventDefault();
				
				var modal = document.getElementById('modal-container');
				
				modal.innerHTML = `
					<div class="modal-backdrop fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
						<div class="modal-card bg-white rounded-lg shadow-xl max-w-md w-full p-6 space-y-4">
							<div class="flex items-start gap-3">
								<div class="shrink-0 w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
									<svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
									</svg>
								</div>
								<div class="flex-1">
									<h3 class="text-lg font-semibold text-gray-900">Delete Comment</h3>
									<p class="mt-1 text-sm text-gray-500">Are you sure you want to delete this comment?</p>
								</div>
							</div>
							<div class="flex gap-3 justify-end">
								<button type="button" class="btn-cancel px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
									Cancel
								</button>
								<button type="button" class="btn-delete px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors">
									Delete
								</button>
							</div>
						</div>
					</div>
				`;
				
				modal.querySelector('.btn-delete').onclick = function() {
					modal.innerHTML = '';
					evt.detail.issueRequest();
				};
				
				modal.querySelector('.btn-cancel').onclick = function() {
					modal.innerHTML = '';
				};
				
				modal.querySelector('.modal-backdrop').onclick = function(e) {
					if (e.target === e.currentTarget) {
						modal.innerHTML = '';
					}
				};
				
				function handleEscape(e) {
					if (e.key === 'Escape') {
						modal.innerHTML = '';
						document.removeEventListener('keydown', handleEscape);
					}
				}
				document.addEventListener('keydown', handleEscape);
			}
		});
	})();
	</script>
}
