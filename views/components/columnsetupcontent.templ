package components

import (
	"encoding/json"

	"pm/internal/model"
)

templ ColumnSetupContent(columns []model.ProjectColumn, taskCounts map[int64]int, orgID int64, projectID int64) {
	<div class="space-y-4">
		<div class="space-y-1">
			<label class="block text-sm font-medium text-gray-700">Columns</label>
			<p class="text-xs text-gray-500">
				if len(columns) > 0 {
					Edit names and colors, delete, reorder, or add new columns
				} else {
					Add, remove, or customize columns for your project workflow
				}
			</p>
		</div>
		<div id="columns-container" class="space-y-2">
		</div>
		<button
			type="button"
			id="add-column-btn"
			class="w-full px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors border border-gray-300 border-dashed cursor-pointer"
		>
			+ Add Column
		</button>
	</div>
	<div id="column-data" style="display:none" data-columns={ serializeColumnsJSON(columns) } data-task-counts={ serializeTaskCountsJSON(taskCounts) }></div>
	@columnSetupInlinedScript(columns, taskCounts, orgID, projectID)
}

templ columnSetupInlinedScript(columns []model.ProjectColumn, taskCounts map[int64]int, orgID int64, projectID int64) {
	<script type="text/javascript">
		(function() {
			// Load data from data attributes
			var dataEl = document.getElementById('column-data');
			var existingColumns = JSON.parse(dataEl.getAttribute('data-columns'));
			var taskCounts = JSON.parse(dataEl.getAttribute('data-task-counts'));

			var defaultColumns = [
				{ name: 'To Do', color: '#6B7280' },
				{ name: 'In Progress', color: '#3B82F6' },
				{ name: 'Done', color: '#10B981' }
			];

			var colors = ['#6B7280', '#EF4444', '#F59E0B', '#10B981', '#3B82F6', '#8B5CF6', '#EC4899', '#14B8A6'];
			var columnIndex = 0;
			var columnsToDelete = {};

			function createColumnRow(name, color, columnId, taskCount) {
				name = name || '';
				color = color || '#6B7280';
				columnId = columnId || null;
				taskCount = taskCount || 0;
				var index = columnIndex++;
				var row = document.createElement('div');
				row.className = 'flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200';
				row.dataset.index = index;
				if (columnId) {
					row.dataset.columnId = columnId;
					row.dataset.taskCount = taskCount;
				}

				var idInput = columnId ? '<input type="hidden" name="columns[' + index + '][id]" value="' + columnId + '" />' : '';

				row.innerHTML = '<div class="flex-shrink-0 w-8 h-8 cursor-move drag-handle flex items-center justify-center text-gray-400 hover:text-gray-600">' +
					'<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
					'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg></div>' +
					'<div class="flex-shrink-0"><div class="w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: ' + color + ';" data-color="' + color + '"></div></div>' +
					'<input type="text" name="columns[' + index + '][name]" value="' + escapeHtml(name) + '" placeholder="Column name" required ' +
					'class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />' +
					idInput +
					'<input type="hidden" name="columns[' + index + '][color]" value="' + color + '" />' +
					'<button type="button" class="color-picker-btn flex-shrink-0 px-3 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">Color</button>' +
					'<button type="button" class="delete-column-btn flex-shrink-0 px-3 py-2 text-xs font-medium text-red-600 bg-white border border-red-300 rounded-lg hover:bg-red-50 transition-colors cursor-pointer">Delete</button>';
				return row;
			}

			function escapeHtml(text) {
				var map = {
					'&': '&amp;',
					'<': '&lt;',
					'>': '&gt;',
					'"': '&quot;',
					"'": '&#039;'
				};
				return text.replace(/[&<>"']/g, function(m) { return map[m]; });
			}

			function createColorPicker(currentColor, onSelect) {
				var modal = document.createElement('div');
				modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
				var colorButtons = colors.map(function(color) {
					var isSelected = color === currentColor;
					return '<button type="button" class="color-option w-12 h-12 rounded-lg border-2 ' +
						(isSelected ? 'border-indigo-600 ring-2 ring-indigo-200' : 'border-gray-300 hover:border-gray-400') +
						' transition-all cursor-pointer" style="background-color: ' + color + ';" data-color="' + color + '"></button>';
				}).join('');

				modal.innerHTML = '<div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full mx-4">' +
					'<h3 class="text-lg font-semibold text-gray-900 mb-4">Choose Color</h3>' +
					'<div class="grid grid-cols-4 gap-3">' + colorButtons + '</div>' +
					'<div class="mt-6 flex justify-end">' +
					'<button type="button" class="cancel-picker px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors cursor-pointer">Cancel</button>' +
					'</div></div>';

				modal.querySelectorAll('.color-option').forEach(function(btn) {
					btn.addEventListener('click', function() {
						var selectedColor = btn.dataset.color;
						onSelect(selectedColor);
						modal.remove();
					});
				});

				modal.querySelector('.cancel-picker').addEventListener('click', function() {
					modal.remove();
				});

				modal.addEventListener('click', function(e) {
					if (e.target === modal) {
						modal.remove();
					}
				});

				return modal;
			}

			function createErrorModal(title, message) {
				var modal = document.createElement('div');
				modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';

				modal.innerHTML = '<div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">' +
					'<h3 class="text-lg font-semibold text-gray-900 mb-3">' + escapeHtml(title) + '</h3>' +
					'<p class="text-sm text-gray-700 mb-6">' + escapeHtml(message) + '</p>' +
					'<div class="flex justify-end">' +
					'<button type="button" class="close-error px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer">OK</button>' +
					'</div></div>';

				modal.querySelector('.close-error').addEventListener('click', function() {
					modal.remove();
				});

				modal.addEventListener('click', function(e) {
					if (e.target === modal) {
						modal.remove();
					}
				});

				document.body.appendChild(modal);
			}

			function createDeleteModal(columnName, taskCount, otherColumns, onConfirm) {
				var modal = document.createElement('div');
				modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';

				var columnOptions = otherColumns.map(function(col) {
					return '<option value="' + col.id + '">' + escapeHtml(col.name) + '</option>';
				}).join('');

				var modalContent = '<div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">' +
					'<h3 class="text-lg font-semibold text-gray-900 mb-3">Delete Column "' + escapeHtml(columnName) + '"?</h3>';

				if (taskCount > 0) {
					modalContent += '<p class="text-sm text-gray-700 mb-4">This column has <strong>' + taskCount + '</strong> task' + (taskCount !== 1 ? 's' : '') + '. Move them to:</p>' +
						'<select id="target-column-select" class="w-full px-3 py-2 mb-6 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">' +
						columnOptions +
						'</select>';
				} else {
					modalContent += '<p class="text-sm text-gray-600 mb-6">This column is empty and can be safely deleted.</p>';
				}

				modalContent += '<div class="flex gap-3 justify-end">' +
					'<button type="button" class="cancel-delete px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors cursor-pointer">Cancel</button>' +
					'<button type="button" class="confirm-delete px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors cursor-pointer">Delete</button>' +
					'</div></div>';

				modal.innerHTML = modalContent;

				modal.querySelector('.confirm-delete').addEventListener('click', function() {
					var targetColumnId = null;
					if (taskCount > 0) {
						targetColumnId = document.getElementById('target-column-select').value;
					}
					onConfirm(targetColumnId);
					modal.remove();
				});

				modal.querySelector('.cancel-delete').addEventListener('click', function() {
					modal.remove();
				});

				modal.addEventListener('click', function(e) {
					if (e.target === modal) {
						modal.remove();
					}
				});

				document.body.appendChild(modal);
			}

			function addColumn(name, color, columnId, taskCount) {
				name = name || '';
				color = color || '#6B7280';
				columnId = columnId || null;
				taskCount = taskCount || 0;

				var container = document.getElementById('columns-container');
				var row = createColumnRow(name, color, columnId, taskCount);

				row.querySelector('.delete-column-btn').addEventListener('click', function() {
					var currentColumnId = row.dataset.columnId;
					var currentTaskCount = parseInt(row.dataset.taskCount || '0');
					var columnName = row.querySelector('input[type="text"]').value;

					var allRows = Array.from(container.querySelectorAll('.flex.items-center.gap-2'));
					var otherColumns = allRows
						.filter(function(r) { return r !== row && r.dataset.columnId; })
						.map(function(r) {
							return {
								id: r.dataset.columnId,
								name: r.querySelector('input[type="text"]').value
							};
						});

					if (allRows.length === 1) {
						createErrorModal('Cannot Delete Column', 'At least one column is required. You cannot delete the last remaining column.');
						return;
					}

					if (currentColumnId && currentTaskCount > 0) {
						createDeleteModal(columnName, currentTaskCount, otherColumns, function(targetColumnId) {
							columnsToDelete[currentColumnId] = targetColumnId;
							row.remove();
							reindexColumns();
						});
					} else {
						if (currentColumnId) {
							columnsToDelete[currentColumnId] = 'delete-empty';
						}
						row.remove();
						reindexColumns();
					}
				});

				row.querySelector('.color-picker-btn').addEventListener('click', function() {
					var colorDot = row.querySelector('[data-color]');
					var colorInput = row.querySelector('input[type="hidden"][name*="color"]');
					var currentColor = colorInput.value;

					var picker = createColorPicker(currentColor, function(newColor) {
						colorDot.style.backgroundColor = newColor;
						colorDot.dataset.color = newColor;
						colorInput.value = newColor;
					});

					document.body.appendChild(picker);
				});

				var nameInput = row.querySelector('input[type="text"]');
				nameInput.addEventListener('input', function() {
					var currentName = this.value.trim().toLowerCase();
					var allRows = Array.from(container.querySelectorAll('.flex.items-center.gap-2'));
					var hasDuplicate = false;

					allRows.forEach(function(otherRow) {
						if (otherRow !== row) {
							var otherNameInput = otherRow.querySelector('input[type="text"]');
							var otherName = otherNameInput.value.trim().toLowerCase();

							if (currentName && otherName && currentName === otherName) {
								hasDuplicate = true;
								nameInput.classList.add('border-red-500');
								nameInput.classList.remove('border-gray-300');
								otherNameInput.classList.add('border-red-500');
								otherNameInput.classList.remove('border-gray-300');
							} else {
								otherNameInput.classList.remove('border-red-500');
								otherNameInput.classList.add('border-gray-300');
							}
						}
					});

					if (!hasDuplicate) {
						nameInput.classList.remove('border-red-500');
						nameInput.classList.add('border-gray-300');
					}
				});

				container.appendChild(row);
			}

			function reindexColumns() {
				var container = document.getElementById('columns-container');
				var rows = container.querySelectorAll('.flex.items-center.gap-2');
				rows.forEach(function(row, index) {
					var nameInput = row.querySelector('input[type="text"]');
					var colorInput = row.querySelector('input[type="hidden"][name*="color"]');
					var idInput = row.querySelector('input[type="hidden"][name*="[id]"]');

					nameInput.name = 'columns[' + index + '][name]';
					colorInput.name = 'columns[' + index + '][color]';
					if (idInput) {
						idInput.name = 'columns[' + index + '][id]';
					}
				});
				columnIndex = rows.length;
			}

			function initSortable() {
				var container = document.getElementById('columns-container');
				if (typeof Sortable !== 'undefined') {
					new Sortable(container, {
						handle: '.drag-handle',
						animation: 150,
						onEnd: function() {
							reindexColumns();
						}
					});
				}
			}

			document.addEventListener('DOMContentLoaded', function() {
				var columnsToLoad = existingColumns.length > 0 ? existingColumns : defaultColumns;

				columnsToLoad.forEach(function(col) {
					if (col.id && taskCounts[col.id]) {
						col.taskCount = taskCounts[col.id];
					}
					addColumn(col.name, col.color, col.id, col.taskCount || 0);
				});

				initSortable();

				document.getElementById('add-column-btn').addEventListener('click', function() {
					addColumn();
				});

				var form = document.querySelector('form[action*="/settings"]');
				if (form) {
					form.addEventListener('submit', function(e) {
						reindexColumns();

						var container = document.getElementById('columns-container');

						if (container.children.length === 0) {
							e.preventDefault();
							createErrorModal('No Columns', 'At least one column is required. Please add a column before saving.');
							return;
						}

						var columnNames = [];
						var rows = container.querySelectorAll('.flex.items-center.gap-2');
						var hasDuplicates = false;
						var duplicateName = '';

						rows.forEach(function(row) {
							var nameInput = row.querySelector('input[type="text"]');
							var name = nameInput.value.trim().toLowerCase();

							if (name && columnNames.includes(name)) {
								hasDuplicates = true;
								duplicateName = nameInput.value.trim();
								nameInput.classList.add('border-red-500');
								nameInput.classList.remove('border-gray-300');
								nameInput.focus();
							} else if (name) {
								columnNames.push(name);
								nameInput.classList.remove('border-red-500');
								nameInput.classList.add('border-gray-300');
							}
						});

						if (hasDuplicates) {
							e.preventDefault();
							createErrorModal('Duplicate Column Name', 'Column name "' + duplicateName + '" is used more than once. Each column must have a unique name.');
							return;
						}

						for (var columnId in columnsToDelete) {
							var target = columnsToDelete[columnId];
							if (target !== 'delete-empty') {
								var input = document.createElement('input');
								input.type = 'hidden';
								input.name = 'delete_column_' + columnId;
								input.value = target;
								this.appendChild(input);
							} else {
								var input = document.createElement('input');
								input.type = 'hidden';
								input.name = 'delete_column_' + columnId;
								input.value = '';
								this.appendChild(input);
							}
						}
					});
				}
			});
		})();
	</script>
}

func serializeColumnsJSON(columns []model.ProjectColumn) string {
	if len(columns) == 0 {
		return "[]"
	}
	type columnJS struct {
		ID        int64  `json:"id"`
		Name      string `json:"name"`
		Color     string `json:"color"`
		TaskCount int    `json:"taskCount"`
	}
	var result []columnJS
	for _, col := range columns {
		result = append(result, columnJS{
			ID:        col.ID,
			Name:      col.Name,
			Color:     col.Color,
			TaskCount: 0,
		})
	}
	data, _ := json.Marshal(result)
	return string(data)
}

func serializeTaskCountsJSON(counts map[int64]int) string {
	data, _ := json.Marshal(counts)
	return string(data)
}