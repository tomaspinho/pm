package components

import (
	"fmt"
	"pm/internal/model"
)

// LabelSection renders the complete labels section for a task (for htmx swaps)
templ LabelSection(taskID int64, labels []model.Label, allLabels []model.Label, orgID int64, projectID int64, currentUser model.User) {
	<div id={"label-section-" + fmt.Sprintf("%d", taskID)} class="label-section space-y-2 relative" data-task-id={ fmt.Sprintf("%d", taskID) } data-org-id={ fmt.Sprintf("%d", orgID) } data-project-id={ fmt.Sprintf("%d", projectID) }>
		<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">
			Labels
		</label>
		<!-- Add Label Form (dropdown) -->
		<div class="label-dropdown hidden absolute z-50 bg-white border border-gray-300 rounded-lg shadow-lg p-2 min-w-[200px] max-h-[200px] overflow-y-auto">
			@renderLabelDropdownItems(taskID, labels, allLabels, orgID, projectID)
		</div>
		<div class="label-list-container">
			@LabelList(taskID, labels, orgID, projectID)
		</div>
		<button
			type="button"
			class="add-label-btn relative text-sm font-medium text-indigo-600 hover:text-indigo-700 cursor-pointer"
      onclick="AddLabel(event);"
		>
			+ Add Label
		</button>
		<!-- Hidden elements for script access -->
		<input type="hidden" class="task-id-input" value={ fmt.Sprintf("%d", taskID) } />
	</div>
	<script>
		function AddLabel(e) {
				var addLabelBtn = e.target.closest('.add-label-btn');
				var clickedInsideDropdown = e.target.closest('.label-dropdown');
				if (addLabelBtn) {
					var section = addLabelBtn.closest('.label-section');
					var dropdown = section.querySelector('.label-dropdown');
					var wasHidden = dropdown.classList.contains('hidden');
					dropdown.classList.toggle('hidden');
					if (wasHidden) {
						var rect = addLabelBtn.getBoundingClientRect();
						dropdown.style.position = 'fixed';
						dropdown.style.left = rect.left + 'px';
						dropdown.style.top = (rect.bottom + 5) + 'px';

            function HideAddLabelDropdown(event) {
              if (!dropdown.contains(event.target)) {
                console.log('Clicked outside the element!');
					      dropdown.classList.toggle('hidden');
                document.removeEventListener('click', HideAddLabelDropdown);
              }
            }

            event.stopPropagation();

            document.addEventListener('click', HideAddLabelDropdown);
					}
				} else if (!clickedInsideDropdown) {
					document.querySelectorAll('.label-dropdown').forEach(function(dd) {
						dd.classList.add('hidden');
						var section = dd.closest('.label-section');
						if (section) {
							var listContainer = section.querySelector('.label-list-container');
							if (listContainer) listContainer.classList.remove('hidden');
						}
					});
				}
		}
  </script>
}

func isLabelApplied(labels []model.Label, labelID int64) bool {
	for _, l := range labels {
		if l.ID == labelID {
			return true
		}
	}
	return false
}

templ renderLabelDropdownItems(taskID int64, labels []model.Label, allLabels []model.Label, orgID int64, projectID int64) {
	if len(allLabels) > 0 {
		for _, label := range allLabels {
			if ! isLabelApplied(labels, label.ID) {
				<button
					type="button"
					class="w-full text-left px-3 py-2 rounded-lg flex items-center gap-2 transition-colors bg-gray-50 hover:bg-gray-100 border border-gray-200 cursor-pointer"
					hx-post={ fmt.Sprintf("/orgs/%d/projects/%d/tasks/%d/labels/%d", orgID, projectID, taskID, label.ID) }
					hx-target="closest .label-section"
					hx-swap="outerHTML"
				>
					<span class="w-3 h-3 rounded-full flex-shrink-0" style={ "background-color: " + label.Color }></span>
					<span class="text-sm">{ label.Name }</span>
				</button>
			}/* else {
				<button
					type="button"
					class="w-full text-left px-3 py-2 rounded-lg flex items-center gap-2 transition-colors bg-gray-100 border border-gray-200 text-gray-900"
					hx-delete={ fmt.Sprintf("/orgs/%d/projects/%d/tasks/%d/labels/%d", orgID, projectID, taskID, label.ID) }
					hx-target="closest .label-section"
					hx-swap="outerHTML"
				>
					<span class="w-3 h-3 rounded-full flex-shrink-0" style={ "background-color: " + label.Color }></span>
					<span class="text-sm">{ label.Name }</span>
				</button>
			}*/
		}
	} else {
		<p class="text-sm text-gray-500 italic px-3 py-2">No labels configured</p>
	}
}

// LabelList renders the list of labels with remove buttons
templ LabelList(taskID int64, labels []model.Label, orgID int64, projectID int64) {
	if len(labels) > 0 {
		<div class="flex flex-wrap gap-2">
			for _, label := range labels {
				@LabelChip(label, true, orgID, projectID, taskID)
			}
		</div>
	} else {
		<p class="text-sm text-gray-400 italic cursor-pointer hover:text-gray-600">
			No labels
		</p>
	}
}
