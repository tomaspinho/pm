package components

import (
	"fmt"
	"pm/internal/model"
)

// LabelSection renders the complete labels section for a task (for htmx swaps)
templ LabelSection(taskID int64, labels []model.Label, allLabels []model.Label, orgID int64, projectID int64, currentUser model.User) {
	<div 
		id={"label-section-" + fmt.Sprintf("%d", taskID)} 
		class="label-section space-y-2 relative" 
		data-task-id={ fmt.Sprintf("%d", taskID) } 
		data-org-id={ fmt.Sprintf("%d", orgID) } 
		data-project-id={ fmt.Sprintf("%d", projectID) }
	>
		<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">
			Labels
		</label>
		<!-- Add Label Form (dropdown) -->
		<div class="label-dropdown hidden fixed z-50 bg-white border border-gray-300 rounded-lg shadow-lg p-2 min-w-[200px] max-h-[200px] overflow-y-auto">
			<div class="space-y-1" id={"label-dropdown-items-" + fmt.Sprintf("%d", taskID)}>
				for _, label := range allLabels {
					@LabelDropdownItem(taskID, label, isLabelApplied(labels, label.ID), orgID, projectID)
				}
			</div>
		</div>
		<div class="label-list-container" id={"label-list-container-" + fmt.Sprintf("%d", taskID)}>
			@LabelList(taskID, labels, orgID, projectID)
		</div>
		<button
			type="button"
			class="add-label-btn relative text-sm font-medium text-indigo-600 hover:text-indigo-700 cursor-pointer"
			onclick="toggleLabelDropdown(this)"
		>
			+ Add Label
		</button>
	</div>
	<script>
		function toggleLabelDropdown(btn) {
			var section = btn.closest('.label-section');
			var dropdown = section.querySelector('.label-dropdown');
			var wasHidden = dropdown.classList.contains('hidden');

			document.querySelectorAll('.label-dropdown').forEach(function(dd) {
				if (dd !== dropdown) dd.classList.add('hidden');
			});

			dropdown.classList.toggle('hidden');

			if (wasHidden) {
				var rect = btn.getBoundingClientRect();
				dropdown.style.left = rect.left + 'px';
				dropdown.style.top = (rect.bottom + 5) + 'px';

				function hideDropdown(event) {
					if (!dropdown.contains(event.target) && !btn.contains(event.target)) {
						dropdown.classList.add('hidden');
						document.removeEventListener('click', hideDropdown);
					}
				}
				setTimeout(function() {
					document.addEventListener('click', hideDropdown);
				}, 0);
			}
		}

		function toggleTaskLabelDetail(btn, action) {
			var section = btn.closest('.label-section');
			var labelID = btn.getAttribute('data-label-id');
			var labelName = btn.getAttribute('data-label-name');
			var labelColor = btn.getAttribute('data-label-color');
			var taskID = section.getAttribute('data-task-id');
			var orgID = section.getAttribute('data-org-id');
			var projectID = section.getAttribute('data-project-id');
			var listContainer = section.querySelector('.label-list-container');
			var isApplied = action === 'DELETE';

			// Update dropdown item visual state
			var checkmark = btn.querySelector('svg');
			if (isApplied) {
				btn.classList.remove('bg-indigo-100', 'border-indigo-200');
				btn.classList.add('bg-gray-50', 'hover:bg-gray-100', 'border-gray-200');
				btn.setAttribute('data-action', 'POST');
				if (checkmark) checkmark.classList.add('hidden');
			} else {
				btn.classList.remove('bg-gray-50', 'hover:bg-gray-100', 'border-gray-200');
				btn.classList.add('bg-indigo-100', 'border-indigo-200');
				btn.setAttribute('data-action', 'DELETE');
				if (checkmark) checkmark.classList.remove('hidden');
			}

			// Update label chips list
			if (isApplied) {
				var chip = listContainer.querySelector('[data-label-id="' + labelID + '"]');
				if (chip) chip.remove();
			} else {
				var chipContainer = listContainer.querySelector('.flex');
				if (!chipContainer) {
					chipContainer = document.createElement('div');
					chipContainer.className = 'flex flex-wrap gap-2';
					listContainer.innerHTML = '';
					listContainer.appendChild(chipContainer);
				}
				var chip = document.createElement('div');
				chip.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border group';
				chip.style.backgroundColor = labelColor;
				chip.style.color = 'white';
				chip.style.borderColor = 'rgba(255,255,255,0.2)';
				chip.setAttribute('data-label-id', labelID);
				chip.setAttribute('data-label-name', labelName);
				chip.setAttribute('data-label-color', labelColor);
				chip.innerHTML = labelName + '<span class="cursor-pointer hover:text-white/80 opacity-0 group-hover:opacity-100" onclick="removeLabelChipFromButton(this)">&times;</span>';
				chipContainer.appendChild(chip);
			}

			// Make the actual request
			var url = '/orgs/' + orgID + '/projects/' + projectID + '/tasks/' + taskID + '/labels/' + labelID;
			fetch(url, { method: action, headers: { 'Content-Type': 'application/json' } })
				.then(function(response) {
					if (!response.ok) {
						// Revert on error
						location.reload();
					}
				})
				.catch(function() {
					location.reload();
				});
		}

		function removeLabelChipFromButton(el) {
			var chip = el.parentElement;
			var labelID = chip.getAttribute('data-label-id');
			var labelName = chip.getAttribute('data-label-name');
			var labelColor = chip.getAttribute('data-label-color');
			var section = el.closest('.label-section');
			var taskID = section.getAttribute('data-task-id');
			var orgID = section.getAttribute('data-org-id');
			var projectID = section.getAttribute('data-project-id');

			// Remove chip
			chip.remove();

			// Update dropdown item
			var btn = section.querySelector('.label-dropdown button[data-label-id="' + labelID + '"]');
			if (btn) {
				btn.classList.remove('bg-indigo-100', 'border-indigo-200');
				btn.classList.add('bg-gray-50', 'hover:bg-gray-100', 'border-gray-200');
				var checkmark = btn.querySelector('svg');
				if (checkmark) checkmark.classList.add('hidden');
			}

			// Make the request
			var url = '/orgs/' + orgID + '/projects/' + projectID + '/tasks/' + taskID + '/labels/' + labelID;
			fetch(url, { method: 'DELETE' });
		}
	</script>
}

func isLabelApplied(labels []model.Label, labelID int64) bool {
	for _, l := range labels {
		if l.ID == labelID {
			return true
		}
	}
	return false
}

// LabelDropdownItem renders a single label in the dropdown with toggle behavior
templ LabelDropdownItem(taskID int64, label model.Label, isApplied bool, orgID int64, projectID int64) {
	<button
		type="button"
		class={ "w-full text-left px-3 py-2 rounded-lg flex items-center gap-2 cursor-pointer label-dropdown-item " + ternary(isApplied, "bg-indigo-100 border border-indigo-200", "bg-gray-50 hover:bg-gray-100 border border-gray-200") }
		data-label-id={ fmt.Sprintf("%d", label.ID) }
		data-label-name={ label.Name }
		data-label-color={ label.Color }
		data-action={ ternary(isApplied, "DELETE", "POST") }
		onclick="toggleTaskLabelDetail(this, this.getAttribute('data-action'))"
	>
		<span class="w-3 h-3 rounded-full flex-shrink-0" style={ "background-color: " + label.Color }></span>
		<span class="text-sm flex-1">{ label.Name }</span>
		<svg class={ "w-4 h-4 text-indigo-600 " + ternary(isApplied, "", "hidden") } fill="currentColor" viewBox="0 0 20 20">
			<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
		</svg>
	</button>
}

func ternary(condition bool, trueVal string, falseVal string) string {
	if condition {
		return trueVal
	}
	return falseVal
}

// LabelList renders the list of labels with remove buttons
templ LabelList(taskID int64, labels []model.Label, orgID int64, projectID int64) {
	if len(labels) > 0 {
		<div class="flex flex-wrap gap-2">
			for _, label := range labels {
				@LabelChipDetail(label, orgID, projectID)
			}
		</div>
	} else {
		<p class="text-sm text-gray-400 italic">
			No labels
		</p>
	}
}

// LabelChipDetail renders a label chip for the task detail pane
templ LabelChipDetail(label model.Label, orgID int64, projectID int64) {
	<div 
		class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border group" 
		style={ "background-color: " + label.Color + "; color: white; border-color: rgba(255,255,255,0.2)" }
		data-label-id={ fmt.Sprintf("%d", label.ID) }
		data-label-name={ label.Name }
		data-label-color={ label.Color }
	>
		<span>{ label.Name }</span>
		<span class="cursor-pointer hover:text-white/80 opacity-0 group-hover:opacity-100" onclick="removeLabelChipFromButton(this)">&times;</span>
	</div>
}