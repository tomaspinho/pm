package components

import (
	"encoding/json"
	"fmt"

	"pm/internal/model"
)

templ LabelSetupContent(labels []model.Label, labelCounts map[int64]int, orgID int64, projectID int64) {
	<div id="label-form-container">
		<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d/settings/labels", orgID, projectID)) } id="label-form" class="space-y-4">
			<div class="space-y-1">
				<label class="block text-sm font-medium text-gray-700">Labels</label>
				<p class="text-xs text-gray-500">
					if len(labels) > 0 {
						Edit names and colors, delete, reorder, or add new labels
					} else {
						No labels yet. Add labels to categorize and prioritize your tasks.
					}
				</p>
			</div>
			<div id="labels-container" class="space-y-2">
			</div>
			<button
				type="button"
				id="add-label-btn"
				class="w-full px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors border border-gray-300 border-dashed cursor-pointer"
			>
				+ Add Label
			</button>
			<div class="flex gap-2 pt-4 border-t border-gray-200">
				<button
					type="submit"
					class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer"
				>
					Save Changes
				</button>
			</div>
		</form>
	</div>
	<div id="label-data" style="display:none" data-labels={ serializeLabelsJSON(labels) } data-task-counts={ serializeLabelTaskCountsJSON(labelCounts) }></div>
	@labelSetupScript(labels, labelCounts)
}

templ labelSetupScript(labels []model.Label, labelCounts map[int64]int) {
	<script type="text/javascript">
	(function() {
		var dataEl = document.getElementById('label-data');
		var existingLabels = JSON.parse(dataEl.getAttribute('data-labels'));
		var labelCounts = JSON.parse(dataEl.getAttribute('data-task-counts'));
		
		var colors = ['#6B7280', '#EF4444', '#F59E0B', '#10B981', '#3B82F6', '#8B5CF6', '#EC4899', '#14B8A6'];
		var labelIndex = 0;
		var labelsToDelete = {};
		
		function createLabelRow(name, color, labelId, taskCount) {
			name = name || '';
			color = color || '#6B7280';
			labelId = labelId || null;
			taskCount = taskCount || 0;
			var index = labelIndex++;
			var row = document.createElement('div');
			row.className = 'flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200';
			row.dataset.index = index;
			if (labelId) {
				row.dataset.labelId = labelId;
			}
			
			var idInput = labelId ? '<input type="hidden" name="labels[' + index + '][id]" value="' + labelId + '" />' : '';
			
			row.innerHTML = '<div class="flex-shrink-0 w-8 h-8 cursor-move drag-handle flex items-center justify-center text-gray-400 hover:text-gray-600">' +
				'<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
				'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg></div>' +
				'<div class="flex-shrink-0"><div class="w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: ' + color + ';" data-color="' + color + '"></div></div>' +
				'<input type="text" name="labels[' + index + '][name]" value="' + escapeHtml(name) + '" placeholder="Label name" required ' +
				'class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />' +
				idInput +
				'<input type="hidden" name="labels[' + index + '][color]" value="' + color + '" />' +
				'<button type="button" class="color-picker-btn flex-shrink-0 px-3 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">Color</button>' +
				'<button type="button" class="delete-label-btn flex-shrink-0 px-3 py-2 text-xs font-medium text-red-600 bg-white border border-red-300 rounded-lg hover:bg-red-50 transition-colors cursor-pointer">Delete</button>';
			return row;
		}
		
		function escapeHtml(text) {
			var map = {
				'&': '&amp;',
				'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				"'": '&#039;'
			};
			return text.replace(/[&<>"']/g, function(m) { return map[m]; });
		}
		
		function createColorPicker(currentColor, onSelect) {
			var modal = document.createElement('div');
			modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
			var colorButtons = colors.map(function(color) {
				var isSelected = color === currentColor;
				return '<button type="button" class="color-option w-12 h-12 rounded-lg border-2 ' +
					(isSelected ? 'border-indigo-600 ring-2 ring-indigo-200' : 'border-gray-300 hover:border-gray-400') +
					' transition-all cursor-pointer" style="background-color: ' + color + ';" data-color="' + color + '"></button>';
			}).join('');
			
			modal.innerHTML = '<div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full mx-4">' +
				'<h3 class="text-lg font-semibold text-gray-900 mb-4">Choose Color</h3>' +
				'<div class="grid grid-cols-4 gap-3">' + colorButtons + '</div>' +
				'<div class="mt-6 flex justify-end">' +
				'<button type="button" class="cancel-picker px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors cursor-pointer">Cancel</button>' +
				'</div></div>';
			
			modal.querySelectorAll('.color-option').forEach(function(btn) {
				btn.addEventListener('click', function() {
					var selectedColor = btn.dataset.color;
					onSelect(selectedColor);
					modal.remove();
				});
			});
			
			modal.querySelector('.cancel-picker').addEventListener('click', function() {
				modal.remove();
			});
			
			modal.addEventListener('click', function(e) {
				if (e.target === modal) {
					modal.remove();
				}
			});
			
			return modal;
		}
		
		function createDeleteModal(labelName, taskCount, onConfirm) {
			var modalContainer = document.getElementById('delete-modal-container');
			var modal = document.createElement('div');
			modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
			
			var modalContent = '<div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">' +
				'<h3 class="text-lg font-semibold text-gray-900 mb-3">Delete label "' + escapeHtml(labelName) + '"?</h3>';
			
			if (taskCount > 0) {
				modalContent += '<p class="text-sm text-gray-700 mb-6">This label is used by <strong>' + taskCount + '</strong> task' + (taskCount !== 1 ? 's' : '') + '. Deleting it will remove the label from all those tasks.</p>';
			} else {
				modalContent += '<p class="text-sm text-gray-600 mb-6">This label is not used on any tasks and can be safely deleted.</p>';
			}
			
			modalContent += '<div class="flex gap-3 justify-end">' +
				'<button type="button" class="cancel-delete px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors cursor-pointer">Cancel</button>' +
				'<button type="button" class="confirm-delete px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors cursor-pointer">Delete</button>' +
				'</div></div>';
			
			modal.innerHTML = modalContent;
			
			modal.querySelector('.confirm-delete').addEventListener('click', function() {
				onConfirm(false);
				modal.remove();
			});
			
			modal.querySelector('.cancel-delete').addEventListener('click', function() {
				modal.remove();
			});
			
			modal.addEventListener('click', function(e) {
				if (e.target === modal) {
					modal.remove();
				}
			});
			
			modalContainer.appendChild(modal);
		}
		
		function addLabel(name, color, labelId) {
			name = name || '';
			color = color || '#6B7280';
			labelId = labelId || null;
			
			var container = document.getElementById('labels-container');
			var row = createLabelRow(name, color, labelId);
			
			row.querySelector('.delete-label-btn').addEventListener('click', function() {
				var currentLabelId = row.dataset.labelId;
				var taskCount = parseInt(row.dataset.taskCount || '0');
				var labelName = row.querySelector('input[type="text"]').value;
				
				if (currentLabelId) {
					createDeleteModal(labelName, taskCount, function() {
						row.remove();
						reindexLabels();
					});
				} else {
					row.remove();
					reindexLabels();
				}
			});
			
			row.querySelector('.color-picker-btn').addEventListener('click', function() {
				var colorDot = row.querySelector('[data-color]');
				var colorInput = row.querySelector('input[type="hidden"][name*="color"]');
				var currentColor = colorInput.value;
				
				var picker = createColorPicker(currentColor, function(newColor) {
					colorDot.style.backgroundColor = newColor;
					colorDot.dataset.color = newColor;
					colorInput.value = newColor;
				});
				
				document.body.appendChild(picker);
			});
			
			var nameInput = row.querySelector('input[type="text"]');
			nameInput.addEventListener('input', function() {
				var currentName = this.value.trim().toLowerCase();
				var allRows = Array.from(container.querySelectorAll('.flex.items-center.gap-2'));
				var hasDuplicate = false;
				
				allRows.forEach(function(otherRow) {
					if (otherRow !== row) {
						var otherNameInput = otherRow.querySelector('input[type="text"]');
						var otherName = otherNameInput.value.trim().toLowerCase();
						
						if (currentName && otherName && currentName === otherName) {
							hasDuplicate = true;
							nameInput.classList.add('border-red-500');
							nameInput.classList.remove('border-gray-300');
							otherNameInput.classList.add('border-red-500');
							otherNameInput.classList.remove('border-gray-300');
						} else {
							otherNameInput.classList.remove('border-red-500');
							otherNameInput.classList.add('border-gray-300');
						}
					}
				});
				
				if (!hasDuplicate) {
					nameInput.classList.remove('border-red-500');
					nameInput.classList.add('border-gray-300');
				}
			});
			
			container.appendChild(row);
		}
		
		function reindexLabels() {
			var container = document.getElementById('labels-container');
			var rows = container.querySelectorAll('.flex.items-center.gap-2');
			rows.forEach(function(row, index) {
				var nameInput = row.querySelector('input[type="text"]');
				var colorInput = row.querySelector('input[type="hidden"][name*="color"]');
				var idInput = row.querySelector('input[type="hidden"][name*="[id]"]');
				
				nameInput.name = 'labels[' + index + '][name]';
				colorInput.name = 'labels[' + index + '][color]';
				if (idInput) {
					idInput.name = 'labels[' + index + '][id]';
				}
			});
			labelIndex = rows.length;
		}
		
		function initSortable() {
			var container = document.getElementById('labels-container');
			if (typeof Sortable !== 'undefined') {
				new Sortable(container, {
					handle: '.drag-handle',
					animation: 150,
					onEnd: function() {
						reindexLabels();
					}
				});
			}
		}
		
		for (var i = 0; i < existingLabels.length; i++) {
			var label = existingLabels[i];
			var taskCount = labelCounts[label.id] || 0;
			addLabel(label.name, label.color, label.id, taskCount);
		}
		
		initSortable();
		
		var addLabelBtn = document.getElementById('add-label-btn');
		if (addLabelBtn) {
			addLabelBtn.addEventListener('click', function() {
				addLabel();
			});
		}
		
		var labelForm = document.getElementById('label-form');
		if (labelForm) {
			labelForm.addEventListener('submit', function(e) {
				reindexLabels();
				
				var container = document.getElementById('labels-container');
				var rows = container.querySelectorAll('.flex.items-center.gap-2');
				var hasDuplicates = false;
				var duplicateName = '';
				
				rows.forEach(function(row) {
					var nameInput = row.querySelector('input[type="text"]');
					var name = nameInput.value.trim().toLowerCase();
					
					var allRows = container.querySelectorAll('.flex.items-center.gap-2');
					allRows.forEach(function(otherRow) {
						if (otherRow !== row) {
							var otherNameInput = otherRow.querySelector('input[type="text"]');
							var otherName = otherNameInput.value.trim().toLowerCase();
							
							if (name && otherName && name === otherName) {
								hasDuplicates = true;
								duplicateName = nameInput.value.trim();
								nameInput.classList.add('border-red-500');
								nameInput.classList.remove('border-gray-300');
							}
						}
					});
				});
				
				if (hasDuplicates) {
					e.preventDefault();
					var modalContainer = document.getElementById('delete-modal-container');
					var modal = document.createElement('div');
					modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
					
					modal.innerHTML = '<div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">' +
						'<h3 class="text-lg font-semibold text-gray-900 mb-3">Duplicate Label Name</h3>' +
						'<p class="text-sm text-gray-700 mb-6">Label name "' + escapeHtml(duplicateName) + '" is used more than once. Each label must have a unique name.</p>' +
						'<div class="flex justify-end">' +
						'<button type="button" class="close-error px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors cursor-pointer">OK</button>' +
						'</div></div>';
					
					modal.querySelector('.close-error').addEventListener('click', function() {
						modal.remove();
					});
					
					modal.addEventListener('click', function(e) {
						if (e.target === modal) {
							modal.remove();
						}
					});
					
					modalContainer.appendChild(modal);
				}
			});
		}
	})();
	</script>
}

func serializeLabels(labels []model.Label) templ.Component {
	return templ.Raw(serializeLabelsJSON(labels))
}

func serializeLabelsJSON(labels []model.Label) string {
	type labelJS struct {
		ID        int64  `json:"id"`
		Name      string `json:"name"`
		Color     string `json:"color"`
		TaskCount int    `json:"taskCount"`
	}
	var result []labelJS
	for _, label := range labels {
		result = append(result, labelJS{
			ID:        label.ID,
			Name:      label.Name,
			Color:     label.Color,
			TaskCount: 0,
		})
	}
	data, _ := json.Marshal(result)
	return string(data)
}

func serializeLabelTaskCounts(labelTaskCounts map[int64]int) templ.Component {
	return templ.Raw(serializeLabelTaskCountsJSON(labelTaskCounts))
}

func serializeLabelTaskCountsJSON(labelCounts map[int64]int) string {
	data, _ := json.Marshal(labelCounts)
	return string(data)
}