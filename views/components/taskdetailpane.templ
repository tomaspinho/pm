package components

import (
	"encoding/json"
	"fmt"
	"net/url"
	"pm/internal/model"
	"sort"
	"strings"
)

// Helper function to build org-scoped task URL prefix
func taskURLPrefix(orgID int64, projectID int64) string {
	return fmt.Sprintf("/orgs/%d/projects/%d/tasks", orgID, projectID)
}

// Helper function to check if a value is a complex JSON type (object or array)
func isComplexJSON(value interface{}) bool {
	switch value.(type) {
	case map[string]interface{}, []interface{}:
		return true
	default:
		return false
	}
}

// Helper function to pretty-print JSON values
func prettyJSON(value interface{}) string {
	bytes, err := json.MarshalIndent(value, "", "  ")
	if err != nil {
		return fmt.Sprintf("%v", value)
	}
	return string(bytes)
}

// Helper function to convert value to string
func valueToString(value interface{}) string {
	if str, ok := value.(string); ok {
		return str
	}
	return fmt.Sprintf("%v", value)
}

// Helper function to URL-encode a key for use in URLs
func urlEncodeKey(key string) string {
	return url.QueryEscape(key)
}

// Helper function to get sorted metadata keys
func getSortedMetadataKeys(metadata model.TaskMetadata) []string {
	keys := make([]string, 0, len(metadata))
	for key := range metadata {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

// Helper function to get due date status class
func dueDateStatusClass(task model.Task) string {
	if task.DueDate == nil {
		return "text-gray-600 bg-gray-50 border-gray-200"
	}
	if task.IsOverdue() {
		return "text-red-600 bg-red-50 border-red-200"
	}
	if task.IsDueSoon() {
		return "text-yellow-600 bg-yellow-50 border-yellow-200"
	}
	return "text-gray-600 bg-gray-50 border-gray-200"
}

// Helper function to format due date display
func formatDueDate(task model.Task) string {
	if task.DueDate == nil {
		return "No due date"
	}

	formatted := task.DueDate.Format("Jan 2, 2006") // "Feb 14, 2026"

	if task.IsOverdue() {
		return formatted + " (Overdue)"
	}
	if task.IsDueSoon() {
		return formatted + " (Due Soon)"
	}
	return formatted
}

// TaskDetailPane renders the slide-out detail pane for a task.
templ TaskDetailPane(taskWithDeps model.TaskWithDependencies, orgID int64, projectID int64, comments []model.CommentThread, currentUser *model.User, activity []model.TaskActivityRecord, labels []model.Label, allLabels []model.Label) {
	<div id="detail-pane" class="detail-pane-backdrop fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-50 flex justify-end">
		<div class="detail-pane-panel bg-white w-full max-w-2xl h-full shadow-2xl overflow-y-auto">
			<!-- Header -->
			<div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between z-10">
				<h2 class="text-lg font-semibold text-gray-900">Task Details</h2>
				<button
					type="button"
					class="close-pane-btn text-gray-400 hover:text-gray-600 transition-colors cursor-pointer"
					onclick="document.getElementById('detail-pane').remove(); history.replaceState(null, '', window.location.pathname.replace(/\/tasks\/\d+$/, ''))"
				>
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<!-- Content -->
			<div class="p-6 space-y-6">
				<!-- Circular Dependency Warning -->
				if taskWithDeps.HasCycle {
					<div class="bg-amber-50 border border-amber-200 rounded-lg p-4 flex items-start gap-3">
						<svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
						</svg>
						<div class="flex-1">
							<p class="text-sm font-medium text-amber-900">Circular Dependency Detected</p>
							<p class="text-xs text-amber-700 mt-1">This task is part of a circular dependency chain.</p>
						</div>
					</div>
				}
				<!-- Title -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Title</label>
					<div id={ "title-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
						@TitleField(taskWithDeps, orgID, false)
					</div>
				</div>
				<!-- Description -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Description</label>
					<div id={ "description-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
						@DescriptionField(taskWithDeps, orgID, false)
					</div>
				</div>
				<!-- Author -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Author</label>
					<div id={ "author-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
						@authorField(taskWithDeps, orgID, false)
					</div>
				</div>
				<!-- Assignees -->
				@AssigneeSection(taskWithDeps.ID, taskWithDeps.Assignees, orgID, taskWithDeps.ProjectID, *currentUser)
				<!-- Labels -->
				@LabelSection(taskWithDeps.ID, labels, allLabels, orgID, taskWithDeps.ProjectID, *currentUser)
				<!-- Due Date -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Due Date</label>
					<div id={ "duedate-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
						@DueDateField(taskWithDeps, orgID, false)
					</div>
				</div>
				<!-- Dependencies Section -->
				<!-- Activity Feed Section -->
				<div id={ "activity-section-" + fmt.Sprintf("%d", taskWithDeps.ID) } class="space-y-4 border-t border-gray-200 pt-6">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Activity</label>
					@TaskActivityFeed(taskWithDeps.ID, orgID, activity)
				</div>
				<div id={ "dependency-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
					@DependencySection(taskWithDeps, orgID)
				</div>
				<!-- Metadata Section -->
				<div id={ "metadata-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
					@MetadataSection(taskWithDeps.ID, orgID, taskWithDeps.ProjectID, taskWithDeps.Metadata)
				</div>
				<!-- Comments Section -->
				<div id={ "comments-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
					@CommentSection(taskWithDeps.ID, orgID, projectID, comments, currentUser)
				</div>
			</div>
		</div>
	</div>
	@detailPaneScript()
}

// DependencySection renders the dependencies section (for htmx swaps).
templ DependencySection(taskWithDeps model.TaskWithDependencies, orgID int64) {
	<div id={ "dependency-section-" + fmt.Sprintf("%d", taskWithDeps.ID) } class="space-y-4 border-t border-gray-200 pt-6">
		<div class="flex items-center justify-between">
			<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Dependencies</label>
		</div>
		<!-- Blocked By -->
		<div class="space-y-2">
			<h4 class="text-sm font-medium text-gray-700">Blocked By</h4>
			if len(taskWithDeps.BlockedBy) > 0 {
				<div class="space-y-1.5">
					for _, dep := range taskWithDeps.BlockedBy {
						<div class="flex items-center gap-2 group">
							<button
								type="button"
								class="flex-1 text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors flex items-center gap-2"
								hx-get={ taskURLPrefix(orgID, dep.ProjectID) + "/" + fmt.Sprintf("%d", dep.ID) + "/detail" }
								hx-target="#detail-pane"
								hx-swap="outerHTML"
							>
								<span
									class="w-2 h-2 rounded-full flex-shrink-0"
									style={ "background-color: " + dep.ColumnColor }
									title={ dep.ColumnName }
								></span>
								<span class="text-sm text-gray-900 flex-1">{ dep.Title }</span>
								if dep.ProjectID != taskWithDeps.ProjectID {
									<span class="text-xs text-gray-500 px-1.5 py-0.5 bg-gray-200 rounded">Cross-project</span>
								}
							</button>
							<button
								type="button"
								class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 hover:text-red-500"
								hx-delete={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) + "/dependencies/" + fmt.Sprintf("%d", dep.ID) }
								hx-target={ "#dependency-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
								hx-swap="outerHTML"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					}
				</div>
			} else {
				<p class="text-sm text-gray-400 italic">No blocking dependencies</p>
			}
		</div>
		<!-- Blocking -->
		<div class="space-y-2">
			<h4 class="text-sm font-medium text-gray-700">Blocking</h4>
			if len(taskWithDeps.Blocking) > 0 {
				<div class="space-y-1.5">
					for _, dep := range taskWithDeps.Blocking {
						<button
							type="button"
							class="w-full text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors flex items-center gap-2"
							hx-get={ taskURLPrefix(orgID, dep.ProjectID) + "/" + fmt.Sprintf("%d", dep.ID) + "/detail" }
							hx-target="#detail-pane"
							hx-swap="outerHTML"
						>
							<span
								class="w-2 h-2 rounded-full flex-shrink-0"
								style={ "background-color: " + dep.ColumnColor }
								title={ dep.ColumnName }
							></span>
							<span class="text-sm text-gray-900 flex-1">{ dep.Title }</span>
							if dep.ProjectID != taskWithDeps.ProjectID {
								<span class="text-xs text-gray-500 px-1.5 py-0.5 bg-gray-200 rounded">Cross-project</span>
							}
						</button>
					}
				</div>
			} else {
				<p class="text-sm text-gray-400 italic">Not blocking any tasks</p>
			}
		</div>
		<!-- Add Dependency Form -->
		<div class="space-y-2">
			<button
				type="button"
				class="text-sm font-medium text-indigo-600 hover:text-indigo-700 cursor-pointer"
				onclick={ toggleAddDependencyForm(fmt.Sprintf("%d", taskWithDeps.ID)) }
			>
				+ Add Dependency
			</button>
			<div
				id={ "add-dependency-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
				class="hidden"
				data-org-id={ fmt.Sprintf("%d", orgID) }
				data-project-id={ fmt.Sprintf("%d", taskWithDeps.ProjectID) }
				data-task-id={ fmt.Sprintf("%d", taskWithDeps.ID) }
			>
				<div class="relative">
					<div class="flex gap-2">
						<div class="flex-1 relative">
							<input
								type="text"
								id={ "task-search-" + fmt.Sprintf("%d", taskWithDeps.ID) }
								placeholder="Search for a task..."
								autocomplete="off"
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
								data-task-id={ fmt.Sprintf("%d", taskWithDeps.ID) }
							/>
							<div
								id={ "task-dropdown-" + fmt.Sprintf("%d", taskWithDeps.ID) }
								class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-80 overflow-y-auto"
							></div>
						</div>
						<button
							type="button"
							class="px-3 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
							onclick={ toggleAddDependencyForm(fmt.Sprintf("%d", taskWithDeps.ID)) }
						>
							Cancel
						</button>
					</div>
					<form
						id={ "hidden-dependency-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
						hx-post={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) + "/dependencies" }
						hx-target={ "#dependency-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
						hx-swap="outerHTML"
						class="hidden"
					>
						<input type="hidden" name="depends_on_id" value=""/>
					</form>
				</div>
			</div>
		</div>
		<!-- Autocomplete Script -->
		<script>
			if (!window.taskAutocompleteInitialized) {
				window.taskAutocompleteInitialized = true;

				window.initTaskDependencyAutocomplete = function(taskID) {
					var searchInput = document.getElementById('task-search-' + taskID);
					var dropdown = document.getElementById('task-dropdown-' + taskID);
					var hiddenForm = document.getElementById('hidden-dependency-form-' + taskID);
					var formDiv = document.getElementById('add-dependency-form-' + taskID);

					if (!searchInput || !dropdown || !hiddenForm || !formDiv) {
						console.error('Required elements not found for taskID:', taskID);
						return;
					}

					var orgID = formDiv.dataset.orgId;
					var projectID = formDiv.dataset.projectId;

					var debounceTimer;
					var selectedIndex = -1;
					var currentResults = [];

					// Load recent tasks on init
					loadTasks('');

					function loadTasks(query) {
						var url = '/orgs/' + orgID + '/tasks/search?q=' + encodeURIComponent(query) + '&exclude=' + taskID;

						fetch(url)
							.then(function(response) { return response.json(); })
							.then(function(results) {
								currentResults = results || [];
								selectedIndex = -1;
								renderDropdown(results, query);
							})
							.catch(function(err) {
								console.error('Failed to load tasks:', err);
								dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-red-500">Error loading tasks</div>';
								dropdown.classList.remove('hidden');
							});
					}

					function renderDropdown(results, query) {
						if (!results || results.length === 0) {
							dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500 italic">No tasks found</div>';
							dropdown.classList.remove('hidden');
							return;
						}

						var html = '';
						results.forEach(function(task, index) {
							var isCurrentProject = task.project_id.toString() === projectID;
							var bgClass = isCurrentProject
								? 'bg-indigo-50 hover:bg-indigo-100'
								: 'bg-gray-100 hover:bg-gray-200';
							var activeClass = index === selectedIndex ? 'ring-2 ring-indigo-500' : '';

							html += '<button type="button" class="w-full text-left px-4 py-3 ' + bgClass + ' ' + activeClass + ' transition-colors border-b border-gray-200 last:border-b-0 cursor-pointer" data-task-id="' + task.id + '" data-index="' + index + '">';
							html += '  <div class="flex items-center gap-2 mb-1">';
							html += '    <span class="w-2 h-2 rounded-full flex-shrink-0" style="background-color: ' + task.column_color + '" title="' + task.column_name + '"></span>';
							html += '    <span class="text-sm font-medium text-gray-900 flex-1">' + escapeHtml(task.title) + '</span>';
							if (!isCurrentProject) {
								html += '    <span class="text-xs text-gray-600 px-1.5 py-0.5 bg-white/50 rounded">' + escapeHtml(task.project_name) + '</span>';
							}
							html += '  </div>';
							if (task.description) {
								html += '  <div class="text-xs text-gray-600 line-clamp-1 ml-4">' + escapeHtml(task.description) + '</div>';
							}
							html += '</button>';
						});

						dropdown.innerHTML = html;
						dropdown.classList.remove('hidden');

						// Add click handlers to dropdown items
						dropdown.querySelectorAll('button[data-task-id]').forEach(function(btn) {
							btn.addEventListener('click', function() {
								selectTask(parseInt(btn.dataset.taskId));
							});
						});
					}

					function escapeHtml(text) {
						var div = document.createElement('div');
						div.textContent = text;
						return div.innerHTML;
					}

					function selectTask(taskId) {
						// Check for circular dependency
						var checkUrl = '/orgs/' + orgID + '/projects/' + projectID + '/tasks/' + taskID + '/dependencies/check?depends_on=' + taskId;

						fetch(checkUrl)
							.then(function(response) { return response.json(); })
							.then(function(data) {
								if (data.would_create_cycle) {
									alert('Cannot add this dependency: it would create a circular dependency chain.');
									return;
								}

								// Submit the form
								var hiddenInput = hiddenForm.querySelector('input[name="depends_on_id"]');
								hiddenInput.value = taskId;
								htmx.trigger(hiddenForm, 'submit');

								// Close the form
								var cancelBtn = formDiv.querySelector('button[onclick*="toggleAddDependencyForm"]');
								if (cancelBtn) cancelBtn.click();
							})
							.catch(function(err) {
								console.error('Failed to check dependency:', err);
								alert('Failed to add dependency. Please try again.');
							});
					}

					// Search input event handlers
					searchInput.addEventListener('input', function(e) {
						clearTimeout(debounceTimer);
						var query = e.target.value.trim();

						debounceTimer = setTimeout(function() {
							loadTasks(query);
						}, 300);
					});

					searchInput.addEventListener('keydown', function(e) {
						if (dropdown.classList.contains('hidden')) return;

						if (e.key === 'ArrowDown') {
							e.preventDefault();
							selectedIndex = Math.min(selectedIndex + 1, currentResults.length - 1);
							renderDropdown(currentResults, searchInput.value.trim());
						} else if (e.key === 'ArrowUp') {
							e.preventDefault();
							selectedIndex = Math.max(selectedIndex - 1, -1);
							renderDropdown(currentResults, searchInput.value.trim());
						} else if (e.key === 'Enter') {
							e.preventDefault();
							if (selectedIndex >= 0 && currentResults[selectedIndex]) {
								selectTask(currentResults[selectedIndex].id);
							} else if (currentResults.length > 0) {
								selectTask(currentResults[0].id);
							}
						} else if (e.key === 'Escape') {
							e.preventDefault();
							dropdown.classList.add('hidden');
						}
					});

					// Close dropdown when clicking outside
					document.addEventListener('click', function(e) {
						if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
							dropdown.classList.add('hidden');
						}
					});
				};
			}
		</script>
	</div>
}

// MetadataSection renders the metadata key-value pairs (for htmx swaps).
templ MetadataSection(taskID int64, orgID int64, projectID int64, metadata model.TaskMetadata) {
	<div id={ "metadata-section-" + fmt.Sprintf("%d", taskID) } class="space-y-4 border-t border-gray-200 pt-6">
		<div class="flex items-center justify-between">
			<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Metadata</label>
		</div>
		if len(metadata) > 0 {
			<div class="space-y-2">
				for _, key := range getSortedMetadataKeys(metadata) {
					@MetadataItem(taskID, orgID, projectID, key, metadata[key])
				}
			</div>
		} else {
			<p class="text-sm text-gray-400 italic">No metadata</p>
		}
		<!-- Add Metadata Form -->
		<div class="space-y-2">
			<button
				type="button"
				class="text-sm font-medium text-indigo-600 hover:text-indigo-700 cursor-pointer"
				onclick={ toggleAddMetadataForm(fmt.Sprintf("%d", taskID)) }
			>
				+ Add Metadata
			</button>
			<div
				id={ "add-metadata-form-" + fmt.Sprintf("%d", taskID) }
				class="hidden"
			>
				<form
					hx-post={ taskURLPrefix(orgID, projectID) + "/" + fmt.Sprintf("%d", taskID) + "/metadata" }
					hx-target={ "#metadata-section-" + fmt.Sprintf("%d", taskID) }
					hx-swap="outerHTML"
					class="space-y-2"
				>
					<input
						type="text"
						name="key"
						placeholder="Key"
						class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
						required
					/>
					<input
						type="text"
						name="value"
						placeholder="Value"
						class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
						required
					/>
					<div class="flex gap-2">
						<button type="submit" class="px-3 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
							Add
						</button>
						<button
							type="button"
							class="px-3 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
							onclick={ toggleAddMetadataForm(fmt.Sprintf("%d", taskID)) }
						>
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

script toggleAddDependencyForm(taskID string) {
	var form = document.getElementById('add-dependency-form-' + taskID);
	var searchInput = document.getElementById('task-search-' + taskID);
	var dropdown = document.getElementById('task-dropdown-' + taskID);

	if (form.classList.contains('hidden')) {
		form.classList.remove('hidden');
		// Initialize autocomplete when form is shown
		if (searchInput && !searchInput.dataset.initialized) {
			window.initTaskDependencyAutocomplete(taskID);
			searchInput.dataset.initialized = 'true';
		}
		// Focus the search input
		setTimeout(function() {
			if (searchInput) searchInput.focus();
		}, 100);
	} else {
		form.classList.add('hidden');
		// Clear search input and hide dropdown when hiding
		if (searchInput) {
			searchInput.value = '';
		}
		if (dropdown) {
			dropdown.classList.add('hidden');
		}
	}
}

script toggleAddMetadataForm(taskID string) {
	var form = document.getElementById('add-metadata-form-' + taskID);
	if (form.classList.contains('hidden')) {
		form.classList.remove('hidden');
	} else {
		form.classList.add('hidden');
		// Clear form inputs when hiding
		var inputs = form.querySelectorAll('input[type="text"]');
		inputs.forEach(function(input) {
			input.value = '';
		});
	}
}

script toggleStatusDropdown(taskID string) {
	var dropdown = document.getElementById('status-dropdown-' + taskID);
	dropdown.classList.toggle('hidden');

	// Close dropdown when clicking outside
	function closeOnClickOutside(e) {
		if (!dropdown.contains(e.target) && !e.target.closest('button[onclick*="toggleStatusDropdown"]')) {
			dropdown.classList.add('hidden');
			document.removeEventListener('click', closeOnClickOutside);
		}
	}

	if (!dropdown.classList.contains('hidden')) {
		// Use setTimeout to avoid immediate closure from the same click
		setTimeout(function() {
			document.addEventListener('click', closeOnClickOutside);
		}, 0);
	}
}

// detailPaneScript handles Escape key and backdrop clicks
templ detailPaneScript() {
	<script>
	(function() {
		var pane = document.getElementById('detail-pane');
		if (!pane) return;

		// Close on Escape key
		function handleEscape(e) {
			if (e.key === 'Escape') {
				pane.remove();
				history.replaceState(null, "", window.location.pathname.replace(/\/tasks\/\d+$/, ""));
				document.removeEventListener('keydown', handleEscape);
			}
		}
		document.addEventListener('keydown', handleEscape);

		// Close on backdrop click
		pane.addEventListener('click', function(e) {
			if (e.target === pane) {
				pane.remove();
				document.removeEventListener('keydown', handleEscape);
				history.replaceState(null, "", window.location.pathname.replace(/\/tasks\/\d+$/, ""));
			}
		});

		// Handle metadata edit/cancel with data attributes
		pane.addEventListener('click', function(e) {
			var target = e.target.closest('[data-show-edit]');
			if (target) {
				var displayId = target.getAttribute('data-show-edit');
				var formId = target.getAttribute('data-show-form');
				var display = document.getElementById(displayId);
				var form = document.getElementById(formId);
				if (display && form) {
					display.classList.add('hidden');
					form.classList.remove('hidden');
				}
				return;
			}

			target = e.target.closest('[data-cancel-edit]');
			if (target) {
				var displayId = target.getAttribute('data-cancel-edit');
				var formId = target.getAttribute('data-cancel-form');
				var display = document.getElementById(displayId);
				var form = document.getElementById(formId);
				if (display && form) {
					display.classList.remove('hidden');
					form.classList.add('hidden');
				}
			}
		});

		// Handle form toggle buttons with data-toggle-form attribute
		pane.addEventListener('click', function(e) {
			var button = e.target.closest('[data-toggle-form]');
			if (button) {
				var formId = button.getAttribute('data-toggle-form');
				var form = document.getElementById(formId);
				if (form) {
					if (form.classList.contains('hidden')) {
						form.classList.remove('hidden');
					} else {
						form.classList.add('hidden');
						// Clear form inputs
						form.querySelectorAll('input').forEach(function(input) {
							input.value = '';
						});
					}
				}
			}
		});
	})();
	</script>
}

// TitleField renders the title field - display mode if !isEditing, form mode if isEditing
templ TitleField(taskWithDeps model.TaskWithDependencies, orgID int64, isEditing bool) {
	if isEditing {
		<form
			hx-patch={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) }
			hx-target={ "#title-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
			hx-swap="outerHTML"
		>
			<input type="hidden" name="field" value="title"/>
			<input type="hidden" name="description" value={ taskWithDeps.Description }/>
			<input type="hidden" name="author" value={ taskWithDeps.Author }/>
			<input type="hidden" name="due_date" value={ taskWithDeps.DueDateString() }/>
			<input
				type="text"
				name="title"
				value={ taskWithDeps.Title }
				class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
				required
			/>
			<div class="flex gap-2 mt-2">
				<button type="submit" class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 cursor-pointer">
					Save
				</button>
				<button
					type="button"
					class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 cursor-pointer"
					hx-get={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) + "/field?field=title" }
					hx-target={ "#title-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					hx-swap="outerHTML"
				>
					Cancel
				</button>
			</div>
		</form>
	} else {
		<div class="editable-field group">
			<div class="flex items-center gap-2">
				<p
					class="text-lg font-semibold text-gray-900 flex-1 cursor-pointer"
					hx-get={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) + "/field?field=title&edit=true" }
					hx-target={ "#title-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					hx-swap="outerHTML"
				>
					{ taskWithDeps.Title }
				</p>
				<button
					type="button"
					class="edit-btn opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 cursor-pointer"
					hx-get={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) + "/field?field=title&edit=true" }
					hx-target={ "#title-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					hx-swap="outerHTML"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
					</svg>
				</button>
			</div>
		</div>
	}
}

