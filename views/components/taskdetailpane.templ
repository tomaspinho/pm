package components

import (
	"pm/internal/model"
	"encoding/json"
	"fmt"
	"net/url"
	"sort"
	"strings"
)

// Helper function to build org-scoped task URL prefix
func taskURLPrefix(orgID int64, projectID int64) string {
	return fmt.Sprintf("/orgs/%d/projects/%d/tasks", orgID, projectID)
}

// Helper function to check if a value is a complex JSON type (object or array)
func isComplexJSON(value interface{}) bool {
	switch value.(type) {
	case map[string]interface{}, []interface{}:
		return true
	default:
		return false
	}
}

// Helper function to pretty-print JSON values
func prettyJSON(value interface{}) string {
	bytes, err := json.MarshalIndent(value, "", "  ")
	if err != nil {
		return fmt.Sprintf("%v", value)
	}
	return string(bytes)
}

// Helper function to convert value to string
func valueToString(value interface{}) string {
	if str, ok := value.(string); ok {
		return str
	}
	return fmt.Sprintf("%v", value)
}

// Helper function to URL-encode a key for use in URLs
func urlEncodeKey(key string) string {
	return url.QueryEscape(key)
}

// Helper function to get sorted metadata keys
func getSortedMetadataKeys(metadata model.TaskMetadata) []string {
	keys := make([]string, 0, len(metadata))
	for key := range metadata {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

// Helper function to get due date status class
func dueDateStatusClass(task model.Task) string {
	if task.DueDate == nil {
		return "text-gray-600 bg-gray-50 border-gray-200"
	}
	if task.IsOverdue() {
		return "text-red-600 bg-red-50 border-red-200"
	}
	if task.IsDueSoon() {
		return "text-yellow-600 bg-yellow-50 border-yellow-200"
	}
	return "text-gray-600 bg-gray-50 border-gray-200"
}

// Helper function to format due date display
func formatDueDate(task model.Task) string {
	if task.DueDate == nil {
		return "No due date"
	}

	formatted := task.DueDate.Format("Jan 2, 2006") // "Feb 14, 2026"

	if task.IsOverdue() {
		return formatted + " (Overdue)"
	}
	if task.IsDueSoon() {
		return formatted + " (Due Soon)"
	}
	return formatted
}
// TaskDetailPane renders the slide-out detail pane for a task.
templ TaskDetailPane(taskWithDeps model.TaskWithDependencies, orgID int64, projectID int64, comments []model.CommentThread, currentUser *model.User) {
	<div id="detail-pane" class="detail-pane-backdrop fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-50 flex justify-end">
		<div class="detail-pane-panel bg-white w-full max-w-2xl h-full shadow-2xl overflow-y-auto">
			<!-- Header -->
			<div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between z-10">
				<h2 class="text-lg font-semibold text-gray-900">Task Details</h2>
				<button
					type="button"
					class="close-pane-btn text-gray-400 hover:text-gray-600 transition-colors cursor-pointer"
					onclick="document.getElementById('detail-pane').remove()"
				>
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<!-- Content -->
			<div class="p-6 space-y-6">
				<!-- Circular Dependency Warning -->
				if taskWithDeps.HasCycle {
					<div class="bg-amber-50 border border-amber-200 rounded-lg p-4 flex items-start gap-3">
						<svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
						</svg>
						<div class="flex-1">
							<p class="text-sm font-medium text-amber-900">Circular Dependency Detected</p>
							<p class="text-xs text-amber-700 mt-1">This task is part of a circular dependency chain.</p>
						</div>
					</div>
				}
				<!-- Title -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Title</label>
					<div
						class="editable-field group"
						id={ "title-display-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<div class="flex items-center gap-2">
							<p
								class="text-lg font-semibold text-gray-900 flex-1 cursor-pointer"
								onclick={ showEditField(fmt.Sprintf("title-%d", taskWithDeps.ID)) }
							>
								{ taskWithDeps.Title }
							</p>
							<button
								type="button"
								class="edit-btn opacity-0 group-hover:opacity-100 transition-opacity text-gray-400"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
								</svg>
							</button>
						</div>
					</div>
					<div
						class="editable-form hidden"
						id={ "title-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<form
							hx-patch={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) }
							hx-target="body"
							hx-swap="none"
						>
							<input
								type="text"
								name="title"
								value={ taskWithDeps.Title }
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
								required
							/>
							<input type="hidden" name="description" value={ taskWithDeps.Description }/>
							<input type="hidden" name="author" value={ taskWithDeps.Author }/>
							<div class="flex gap-2 mt-2">
								<button type="submit" class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
									Save
								</button>
								<button
									type="button"
									class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
									onclick={ cancelEditField(fmt.Sprintf("title-%d", taskWithDeps.ID)) }
								>
									Cancel
								</button>
							</div>
						</form>
					</div>
				</div>
				<!-- Description -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Description</label>
					<div
						class="editable-field group"
						id={ "description-display-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<div class="flex items-start gap-2">
							<p
								class="text-sm text-gray-700 flex-1 whitespace-pre-wrap cursor-pointer"
								onclick={ showEditField(fmt.Sprintf("description-%d", taskWithDeps.ID)) }
							>
								if taskWithDeps.Description != "" {
									{ taskWithDeps.Description }
								} else {
									<span class="text-gray-400 italic">No description</span>
								}
							</p>
							<button
								type="button"
								class="edit-btn opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 shrink-0"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
								</svg>
							</button>
						</div>
					</div>
					<div
						class="editable-form hidden"
						id={ "description-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<form
							hx-patch={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) }
							hx-target="body"
							hx-swap="none"
						>
							<textarea
								name="description"
								rows="4"
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
							>{ taskWithDeps.Description }</textarea>
							<input type="hidden" name="title" value={ taskWithDeps.Title }/>
							<input type="hidden" name="author" value={ taskWithDeps.Author }/>
							<div class="flex gap-2 mt-2">
								<button type="submit" class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
									Save
								</button>
								<button
									type="button"
									class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
									onclick={ cancelEditField(fmt.Sprintf("description-%d", taskWithDeps.ID)) }
								>
									Cancel
								</button>
							</div>
						</form>
					</div>
				</div>
				<!-- Author -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Author</label>
					<div
						class="editable-field group"
						id={ "author-display-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<div class="flex items-center gap-2">
							<p
								class="text-sm text-gray-700 flex-1 cursor-pointer"
								onclick={ showEditField(fmt.Sprintf("author-%d", taskWithDeps.ID)) }
							>
								if taskWithDeps.Author != "" {
									{ taskWithDeps.Author }
								} else {
									<span class="text-gray-400 italic">No author</span>
								}
							</p>
							<button
								type="button"
								class="edit-btn opacity-0 group-hover:opacity-100 transition-opacity text-gray-400"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
								</svg>
							</button>
						</div>
					</div>
					<div
						class="editable-form hidden"
						id={ "author-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<form
							hx-patch={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) }
							hx-target="body"
							hx-swap="none"
						>
							<input
								type="text"
								name="author"
								value={ taskWithDeps.Author }
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
							/>
							<input type="hidden" name="title" value={ taskWithDeps.Title }/>
							<input type="hidden" name="description" value={ taskWithDeps.Description }/>
							<div class="flex gap-2 mt-2">
								<button type="submit" class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
									Save
								</button>
								<button
									type="button"
									class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
									onclick={ cancelEditField(fmt.Sprintf("author-%d", taskWithDeps.ID)) }
								>
									Cancel
								</button>
							</div>
						</form>
					</div>
				</div>
				<!-- Assignees -->
				@AssigneeSection(taskWithDeps.ID, taskWithDeps.Assignees, orgID, taskWithDeps.ProjectID, *currentUser)
				<!-- Due Date -->
				<div class="space-y-2">
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Due Date</label>
					<div
						class="editable-field group"
						id={ "duedate-display-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<div class="flex items-center gap-2">
							<p
								class={ "flex-1 cursor-pointer px-3 py-2 rounded-lg border text-sm", dueDateStatusClass(taskWithDeps.Task) }
								onclick={ showEditField(fmt.Sprintf("duedate-%d", taskWithDeps.ID)) }
							>
								{ formatDueDate(taskWithDeps.Task) }
							</p>
							<button
								type="button"
								class="edit-btn opacity-0 group-hover:opacity-100 transition-opacity text-gray-400"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
								</svg>
							</button>
						</div>
					</div>
					<div
						class="editable-form hidden"
						id={ "duedate-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
					>
						<form
							hx-patch={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) }
							hx-target="body"
							hx-swap="none"
						>
							<input
								type="date"
								name="due_date"
								value={ taskWithDeps.DueDateString() }
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
							/>
							<input type="hidden" name="title" value={ taskWithDeps.Title }/>
							<input type="hidden" name="description" value={ taskWithDeps.Description }/>
							<input type="hidden" name="author" value={ taskWithDeps.Author }/>
							<div class="flex gap-2 mt-2">
								<button type="submit" class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
									Save
								</button>
								<button
									type="button"
									class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
									onclick={ cancelEditField(fmt.Sprintf("duedate-%d", taskWithDeps.ID)) }
								>
									Cancel
								</button>
							</div>
						</form>
					</div>
				</div>
// TEMPORARILY COMMENTED: 				<!-- Status -->
// TEMPORARILY COMMENTED: 				<div class="space-y-2">
// TEMPORARILY COMMENTED: 					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Status</label>
// TEMPORARILY COMMENTED: 					<div class="relative" id={ "status-badge-" + fmt.Sprintf("%d", taskWithDeps.ID) }>
// TEMPORARILY COMMENTED: 						<!-- Clickable Status Badge -->
// TEMPORARILY COMMENTED: 						<button
// TEMPORARILY COMMENTED: 							type="button"
// TEMPORARILY COMMENTED: 							class="inline-flex items-center gap-2 px-3 py-1 text-sm font-medium rounded-full bg-indigo-100 text-indigo-800 hover:bg-indigo-200 transition-colors cursor-pointer"
// TEMPORARILY COMMENTED: 							onclick={ toggleStatusDropdown(fmt.Sprintf("%d", taskWithDeps.ID)) }
// TEMPORARILY COMMENTED: 						>
// TEMPORARILY COMMENTED: 							<span>{ model.StatusLabel(taskWithDeps.Status) }</span>
// TEMPORARILY COMMENTED: 							<!-- Dropdown chevron icon -->
// TEMPORARILY COMMENTED: 							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
// TEMPORARILY COMMENTED: 								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
// TEMPORARILY COMMENTED: 							</svg>
// TEMPORARILY COMMENTED: 						</button>
// TEMPORARILY COMMENTED: 						<!-- Dropdown Menu (hidden by default) -->
// TEMPORARILY COMMENTED: 						<div
