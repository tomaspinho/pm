// DependencySection renders the dependencies section (for htmx swaps).
templ DependencySection(taskWithDeps model.TaskWithDependencies, orgID int64) {
	<div id={ "dependency-section-" + fmt.Sprintf("%d", taskWithDeps.ID) } class="space-y-4 border-t border-gray-200 pt-6">
		<div class="flex items-center justify-between">
			<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Dependencies</label>
		</div>
		<!-- Blocked By -->
		<div class="space-y-2">
			<h4 class="text-sm font-medium text-gray-700">Blocked By</h4>
			if len(taskWithDeps.BlockedBy) > 0 {
				<div class="space-y-1.5">
					for _, dep := range taskWithDeps.BlockedBy {
						<div class="flex items-center gap-2 group">
							<button
								type="button"
								class="flex-1 text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors flex items-center gap-2"
								hx-get={ taskURLPrefix(orgID, dep.ProjectID) + "/" + fmt.Sprintf("%d", dep.ID) + "/detail" }
								hx-target="#detail-pane"
								hx-swap="outerHTML"
							>
								<span
									class="w-2 h-2 rounded-full flex-shrink-0"
									style={ "background-color: " + dep.ColumnColor }
									title={ dep.ColumnName }
								></span>
								<span class="text-sm text-gray-900 flex-1">{ dep.Title }</span>
								if dep.ProjectID != taskWithDeps.ProjectID {
									<span class="text-xs text-gray-500 px-1.5 py-0.5 bg-gray-200 rounded">Cross-project</span>
								}
							</button>
							<button
								type="button"
								class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 hover:text-red-500"
								hx-delete={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) + "/dependencies/" + fmt.Sprintf("%d", dep.ID) }
								hx-target={ "#dependency-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
								hx-swap="outerHTML"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					}
				</div>
			} else {
				<p class="text-sm text-gray-400 italic">No blocking dependencies</p>
			}
		</div>
		<!-- Blocking -->
		<div class="space-y-2">
			<h4 class="text-sm font-medium text-gray-700">Blocking</h4>
			if len(taskWithDeps.Blocking) > 0 {
				<div class="space-y-1.5">
					for _, dep := range taskWithDeps.Blocking {
						<button
							type="button"
							class="w-full text-left px-3 py-2 bg-gray-50 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors flex items-center gap-2"
							hx-get={ taskURLPrefix(orgID, dep.ProjectID) + "/" + fmt.Sprintf("%d", dep.ID) + "/detail" }
							hx-target="#detail-pane"
							hx-swap="outerHTML"
						>
							<span
								class="w-2 h-2 rounded-full flex-shrink-0"
								style={ "background-color: " + dep.ColumnColor }
								title={ dep.ColumnName }
							></span>
							<span class="text-sm text-gray-900 flex-1">{ dep.Title }</span>
							if dep.ProjectID != taskWithDeps.ProjectID {
								<span class="text-xs text-gray-500 px-1.5 py-0.5 bg-gray-200 rounded">Cross-project</span>
							}
						</button>
					}
				</div>
			} else {
				<p class="text-sm text-gray-400 italic">Not blocking any tasks</p>
			}
		</div>
		<!-- Add Dependency Form -->
		<div class="space-y-2">
			<button
				type="button"
				class="text-sm font-medium text-indigo-600 hover:text-indigo-700 cursor-pointer"
				onclick={ toggleAddDependencyForm(fmt.Sprintf("%d", taskWithDeps.ID)) }
			>
				+ Add Dependency
			</button>
			<div
				id={ "add-dependency-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
				class="hidden"
				data-org-id={ fmt.Sprintf("%d", orgID) }
				data-project-id={ fmt.Sprintf("%d", taskWithDeps.ProjectID) }
				data-task-id={ fmt.Sprintf("%d", taskWithDeps.ID) }
			>
				<div class="relative">
					<div class="flex gap-2">
						<div class="flex-1 relative">
							<input
								type="text"
								id={ "task-search-" + fmt.Sprintf("%d", taskWithDeps.ID) }
								placeholder="Search for a task..."
								autocomplete="off"
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
								data-task-id={ fmt.Sprintf("%d", taskWithDeps.ID) }
							/>
							<div
								id={ "task-dropdown-" + fmt.Sprintf("%d", taskWithDeps.ID) }
								class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-80 overflow-y-auto"
							></div>
						</div>
						<button
							type="button"
							class="px-3 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
							onclick={ toggleAddDependencyForm(fmt.Sprintf("%d", taskWithDeps.ID)) }
						>
							Cancel
						</button>
					</div>
					<form
						id={ "hidden-dependency-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
						hx-post={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) + "/dependencies" }
						hx-target={ "#dependency-section-" + fmt.Sprintf("%d", taskWithDeps.ID) }
						hx-swap="outerHTML"
						class="hidden"
					>
						<input type="hidden" name="depends_on_id" value=""/>
					</form>
				</div>
			</div>
		</div>
		<!-- Autocomplete Script -->
		<script>
			if (!window.taskAutocompleteInitialized) {
				window.taskAutocompleteInitialized = true;

				window.initTaskDependencyAutocomplete = function(taskID) {
					var searchInput = document.getElementById('task-search-' + taskID);
					var dropdown = document.getElementById('task-dropdown-' + taskID);
					var hiddenForm = document.getElementById('hidden-dependency-form-' + taskID);
					var formDiv = document.getElementById('add-dependency-form-' + taskID);

					if (!searchInput || !dropdown || !hiddenForm || !formDiv) {
						console.error('Required elements not found for taskID:', taskID);
						return;
					}

					var orgID = formDiv.dataset.orgId;
					var projectID = formDiv.dataset.projectId;

					var debounceTimer;
					var selectedIndex = -1;
					var currentResults = [];

					// Load recent tasks on init
					loadTasks('');

					function loadTasks(query) {
						var url = '/orgs/' + orgID + '/tasks/search?q=' + encodeURIComponent(query) + '&exclude=' + taskID;

						fetch(url)
							.then(function(response) { return response.json(); })
							.then(function(results) {
								currentResults = results || [];
								selectedIndex = -1;
								renderDropdown(results, query);
							})
							.catch(function(err) {
								console.error('Failed to load tasks:', err);
								dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-red-500">Error loading tasks</div>';
								dropdown.classList.remove('hidden');
							});
					}

					function renderDropdown(results, query) {
						if (!results || results.length === 0) {
							dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500 italic">No tasks found</div>';
							dropdown.classList.remove('hidden');
							return;
						}

						var html = '';
						results.forEach(function(task, index) {
							var isCurrentProject = task.project_id.toString() === projectID;
							var bgClass = isCurrentProject 
								? 'bg-indigo-50 hover:bg-indigo-100'
								: 'bg-gray-100 hover:bg-gray-200';
							var activeClass = index === selectedIndex ? 'ring-2 ring-indigo-500' : '';

							html += '<button type="button" class="w-full text-left px-4 py-3 ' + bgClass + ' ' + activeClass + ' transition-colors border-b border-gray-200 last:border-b-0 cursor-pointer" data-task-id="' + task.id + '" data-index="' + index + '">';
							html += '  <div class="flex items-center gap-2 mb-1">';
							html += '    <span class="w-2 h-2 rounded-full flex-shrink-0" style="background-color: ' + task.column_color + '" title="' + task.column_name + '"></span>';
							html += '    <span class="text-sm font-medium text-gray-900 flex-1">' + escapeHtml(task.title) + '</span>';
							if (!isCurrentProject) {
								html += '    <span class="text-xs text-gray-600 px-1.5 py-0.5 bg-white/50 rounded">' + escapeHtml(task.project_name) + '</span>';
							}
							html += '  </div>';
							if (task.description) {
								html += '  <div class="text-xs text-gray-600 line-clamp-1 ml-4">' + escapeHtml(task.description) + '</div>';
							}
							html += '</button>';
						});

						dropdown.innerHTML = html;
						dropdown.classList.remove('hidden');

						// Add click handlers to dropdown items
						dropdown.querySelectorAll('button[data-task-id]').forEach(function(btn) {
							btn.addEventListener('click', function() {
								selectTask(parseInt(btn.dataset.taskId));
							});
						});
					}

					function escapeHtml(text) {
						var div = document.createElement('div');
						div.textContent = text;
						return div.innerHTML;
					}

					function selectTask(taskId) {
						// Check for circular dependency
						var checkUrl = '/orgs/' + orgID + '/projects/' + projectID + '/tasks/' + taskID + '/dependencies/check?depends_on=' + taskId;

						fetch(checkUrl)
							.then(function(response) { return response.json(); })
							.then(function(data) {
								if (data.would_create_cycle) {
									alert('Cannot add this dependency: it would create a circular dependency chain.');
									return;
								}

								// Submit the form
								var hiddenInput = hiddenForm.querySelector('input[name="depends_on_id"]');
								hiddenInput.value = taskId;
								htmx.trigger(hiddenForm, 'submit');

								// Close the form
								var cancelBtn = formDiv.querySelector('button[onclick*="toggleAddDependencyForm"]');
								if (cancelBtn) cancelBtn.click();
							})
							.catch(function(err) {
								console.error('Failed to check dependency:', err);
								alert('Failed to add dependency. Please try again.');
							});
					}

					// Search input event handlers
					searchInput.addEventListener('input', function(e) {
						clearTimeout(debounceTimer);
						var query = e.target.value.trim();

						debounceTimer = setTimeout(function() {
							loadTasks(query);
						}, 300);
					});

					searchInput.addEventListener('keydown', function(e) {
						if (dropdown.classList.contains('hidden')) return;

						if (e.key === 'ArrowDown') {
							e.preventDefault();
							selectedIndex = Math.min(selectedIndex + 1, currentResults.length - 1);
							renderDropdown(currentResults, searchInput.value.trim());
						} else if (e.key === 'ArrowUp') {
							e.preventDefault();
							selectedIndex = Math.max(selectedIndex - 1, -1);
							renderDropdown(currentResults, searchInput.value.trim());
						} else if (e.key === 'Enter') {
							e.preventDefault();
							if (selectedIndex >= 0 && currentResults[selectedIndex]) {
								selectTask(currentResults[selectedIndex].id);
							} else if (currentResults.length > 0) {
								selectTask(currentResults[0].id);
							}
						} else if (e.key === 'Escape') {
							e.preventDefault();
							dropdown.classList.add('hidden');
						}
					});

					// Close dropdown when clicking outside
					document.addEventListener('click', function(e) {
						if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
							dropdown.classList.add('hidden');
						}
					});
				};
			}
		</script>
	</div>
}

// MetadataSection renders the metadata key-value pairs (for htmx swaps).
templ MetadataSection(taskID int64, orgID int64, projectID int64, metadata model.TaskMetadata) {
	<div id={ "metadata-section-" + fmt.Sprintf("%d", taskID) } class="space-y-4 border-t border-gray-200 pt-6">
		<div class="flex items-center justify-between">
			<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Metadata</label>
		</div>
		if len(metadata) > 0 {
			<div class="space-y-2">
				for _, key := range getSortedMetadataKeys(metadata) {
					@MetadataItem(taskID, orgID, projectID, key, metadata[key])
				}
			</div>
		} else {
			<p class="text-sm text-gray-400 italic">No metadata</p>
		}
		<!-- Add Metadata Form -->
		<div class="space-y-2">
			<button
				type="button"
				class="text-sm font-medium text-indigo-600 hover:text-indigo-700 cursor-pointer"
				onclick={ toggleAddMetadataForm(fmt.Sprintf("%d", taskID)) }
			>
				+ Add Metadata
			</button>
			<div
				id={ "add-metadata-form-" + fmt.Sprintf("%d", taskID) }
				class="hidden"
			>
				<form
					hx-post={ taskURLPrefix(orgID, projectID) + "/" + fmt.Sprintf("%d", taskID) + "/metadata" }
					hx-target={ "#metadata-section-" + fmt.Sprintf("%d", taskID) }
					hx-swap="outerHTML"
					class="space-y-2"
				>
					<input
						type="text"
						name="key"
						placeholder="Key"
						class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
						required
					/>
					<input
						type="text"
						name="value"
						placeholder="Value"
						class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
						required
					/>
					<div class="flex gap-2">
						<button type="submit" class="px-3 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
							Add
						</button>
						<button
							type="button"
							class="px-3 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
							onclick={ toggleAddMetadataForm(fmt.Sprintf("%d", taskID)) }
						>
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

// JavaScript helper functions
script showEditField(field string) {
  var fieldSplitted = field.split('-');
	document.getElementById(fieldSplitted[0] + '-display-' + fieldSplitted[1]).classList.add('hidden');
	var formElement = document.getElementById(fieldSplitted[0] + '-form-' + fieldSplitted[1]);
	formElement.classList.remove('hidden');

	// Focus the first input/textarea in the form
	var input = formElement.querySelector('input[type="text"], input[type="date"], textarea');
	if (input) {
		// Use setTimeout to ensure the element is visible before focusing
		setTimeout(function() {
			input.focus();
			// For date inputs, trigger showPicker() to open the calendar immediately
			if (input.type === 'date' && input.showPicker) {
				try {
					input.showPicker();
				} catch (e) {
					// showPicker() might fail in some browsers or contexts, ignore the error
				}
			}
		}, 10);
	}
}

script cancelEditField(field string) {
  var fieldSplitted = field.split('-')
	document.getElementById(fieldSplitted[0] + '-display-' + fieldSplitted[1]).classList.remove('hidden');
	document.getElementById(fieldSplitted[0] + '-form-' + fieldSplitted[1]).classList.add('hidden');
}

script toggleAddDependencyForm(taskID string) {
	var form = document.getElementById('add-dependency-form-' + taskID);
	var searchInput = document.getElementById('task-search-' + taskID);
	var dropdown = document.getElementById('task-dropdown-' + taskID);

	if (form.classList.contains('hidden')) {
		form.classList.remove('hidden');
		// Initialize autocomplete when form is shown
		if (searchInput && !searchInput.dataset.initialized) {
			window.initTaskDependencyAutocomplete(taskID);
			searchInput.dataset.initialized = 'true';
		}
		// Focus the search input
		setTimeout(function() {
			if (searchInput) searchInput.focus();
		}, 100);
	} else {
		form.classList.add('hidden');
		// Clear search input and hide dropdown when hiding
		if (searchInput) {
			searchInput.value = '';
		}
		if (dropdown) {
			dropdown.classList.add('hidden');
		}
	}
}

script toggleAddMetadataForm(taskID string) {
	var form = document.getElementById('add-metadata-form-' + taskID);
	if (form.classList.contains('hidden')) {
		form.classList.remove('hidden');
	} else {
		form.classList.add('hidden');
		// Clear form inputs when hiding
		var inputs = form.querySelectorAll('input[type="text"]');
		inputs.forEach(function(input) {
			input.value = '';
		});
	}
}

script toggleStatusDropdown(taskID string) {
	var dropdown = document.getElementById('status-dropdown-' + taskID);
	dropdown.classList.toggle('hidden');

	// Close dropdown when clicking outside
	function closeOnClickOutside(e) {
		if (!dropdown.contains(e.target) && !e.target.closest('button[onclick*="toggleStatusDropdown"]')) {
			dropdown.classList.add('hidden');
			document.removeEventListener('click', closeOnClickOutside);
		}
	}

	if (!dropdown.classList.contains('hidden')) {
		// Use setTimeout to avoid immediate closure from the same click
		setTimeout(function() {
			document.addEventListener('click', closeOnClickOutside);
		}, 0);
	}
}

// detailPaneScript handles Escape key and backdrop clicks
templ detailPaneScript() {
	<script>
	(function() {
		var pane = document.getElementById('detail-pane');
		if (!pane) return;

		// Close on Escape key
		function handleEscape(e) {
			if (e.key === 'Escape') {
				pane.remove();
				document.removeEventListener('keydown', handleEscape);
			}
		}
		document.addEventListener('keydown', handleEscape);

		// Close on backdrop click
		pane.addEventListener('click', function(e) {
			if (e.target === pane) {
				pane.remove();
				document.removeEventListener('keydown', handleEscape);
			}
		});

		// Handle metadata edit/cancel with data attributes
		pane.addEventListener('click', function(e) {
			var target = e.target.closest('[data-show-edit]');
			if (target) {
				var displayId = target.getAttribute('data-show-edit');
				var formId = target.getAttribute('data-show-form');
				var display = document.getElementById(displayId);
				var form = document.getElementById(formId);
				if (display && form) {
					display.classList.add('hidden');
					form.classList.remove('hidden');
				}
				return;
			}

			target = e.target.closest('[data-cancel-edit]');
			if (target) {
				var displayId = target.getAttribute('data-cancel-edit');
				var formId = target.getAttribute('data-cancel-form');
				var display = document.getElementById(displayId);
				var form = document.getElementById(formId);
				if (display && form) {
					display.classList.remove('hidden');
					form.classList.add('hidden');
				}
			}
		});

		// Handle form toggle buttons with data-toggle-form attribute
		pane.addEventListener('click', function(e) {
			var button = e.target.closest('[data-toggle-form]');
			if (button) {
				var formId = button.getAttribute('data-toggle-form');
				var form = document.getElementById(formId);
				if (form) {
					if (form.classList.contains('hidden')) {
						form.classList.remove('hidden');
					} else {
						form.classList.add('hidden');
						// Clear form inputs
						form.querySelectorAll('input').forEach(function(input) {
							input.value = '';
						});
					}
				}
			}
		});
	})();
	</script>
}

