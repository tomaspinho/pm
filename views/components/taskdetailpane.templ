// MetadataItem renders a single metadata key-value pair with inline editing
templ MetadataItem(taskID int64, orgID int64, projectID int64, key string, value interface{}) {
	<div class="flex items-start gap-2 group">
		<!-- Display Mode -->
		<div
			id={ "metadata-display-" + key + "-" + fmt.Sprintf("%d", taskID) }
			class="flex-1"
		>
			<div
				class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-lg border border-gray-200 cursor-pointer hover:bg-gray-100 transition-colors"
				data-show-edit={ "metadata-display-" + key + "-" + fmt.Sprintf("%d", taskID) }
				data-show-form={ "metadata-form-" + key + "-" + fmt.Sprintf("%d", taskID) }
			>
				<div class="flex-1">
					<span class="text-xs font-medium text-gray-500">{ key }:</span>
					<span class="text-sm text-gray-900 ml-2">
						if isComplexJSON(value) {
							<span class="font-mono text-xs">{ strings.ReplaceAll(prettyJSON(value), "\n", " ") }</span>
						} else {
							{ valueToString(value) }
						}
					</span>
				</div>
				<button
					type="button"
					class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 hover:text-blue-500"
					title="Edit"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
					</svg>
				</button>
			</div>
		</div>
		<!-- Delete Button -->
		<button
			type="button"
			class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 hover:text-red-500 mt-2"
			hx-delete={ taskURLPrefix(orgID, projectID) + "/" + fmt.Sprintf("%d", taskID) + "/metadata/" + urlEncodeKey(key) }
			hx-target={ "#metadata-section-" + fmt.Sprintf("%d", taskID) }
			hx-swap="outerHTML"
			title="Delete"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
		<!-- Edit Mode -->
		<div
			id={ "metadata-form-" + key + "-" + fmt.Sprintf("%d", taskID) }
			class="hidden flex-1"
		>
			<form
				hx-patch={ taskURLPrefix(orgID, projectID) + "/" + fmt.Sprintf("%d", taskID) + "/metadata/" + urlEncodeKey(key) }
				hx-target={ "#metadata-section-" + fmt.Sprintf("%d", taskID) }
				hx-swap="outerHTML"
				class="space-y-2"
			>
				<div>
					<label class="block text-xs font-medium text-gray-600 mb-1">Key</label>
					<input
						type="text"
						name="key"
						value={ key }
						class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
						required
					/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-600 mb-1">Value</label>
					if isComplexJSON(value) {
						<textarea
							name="value"
							rows="6"
							class="w-full px-3 py-2 text-sm font-mono border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
							required
						>{ prettyJSON(value) }</textarea>
					} else {
						<input
							type="text"
							name="value"
							value={ valueToString(value) }
							class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
							required
						/>
					}
				</div>
				<div class="flex gap-2">
					<button
						type="submit"
						class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700"
					>
						Save
					</button>
					<button
						type="button"
						class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
						data-cancel-edit={ "metadata-display-" + key + "-" + fmt.Sprintf("%d", taskID) }
						data-cancel-form={ "metadata-form-" + key + "-" + fmt.Sprintf("%d", taskID) }
					>
						Cancel
					</button>
				</div>
			</form>
		</div>
	</div>
}

// DueDateDisplay renders just the due date display section for OOB swaps
templ DueDateDisplay(taskWithDeps model.TaskWithDependencies, orgID int64) {
	<div
		class="editable-field group"
		id={ "duedate-display-" + fmt.Sprintf("%d", taskWithDeps.ID) }
		hx-swap-oob="true"
	>
		<div class="flex items-center gap-2">
			<p
				class={ "flex-1 cursor-pointer px-3 py-2 rounded-lg border text-sm", dueDateStatusClass(taskWithDeps.Task) }
				onclick={ showEditField(fmt.Sprintf("duedate-%d", taskWithDeps.ID)) }
			>
				{ formatDueDate(taskWithDeps.Task) }
			</p>
			<button
				type="button"
				class="edit-btn opacity-0 group-hover:opacity-100 transition-opacity text-gray-400"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
				</svg>
			</button>
		</div>
	</div>
}

// DueDateForm renders just the due date edit form for OOB swaps
templ DueDateForm(taskWithDeps model.TaskWithDependencies, orgID int64) {
	<div
		class="editable-form hidden"
		id={ "duedate-form-" + fmt.Sprintf("%d", taskWithDeps.ID) }
		hx-swap-oob="true"
	>
		<form
			hx-patch={ taskURLPrefix(orgID, taskWithDeps.ProjectID) + "/" + fmt.Sprintf("%d", taskWithDeps.ID) }
			hx-target="body"
			hx-swap="none"
		>
			<input
				type="date"
				name="due_date"
				value={ taskWithDeps.DueDateString() }
				class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
			/>
			<input type="hidden" name="title" value={ taskWithDeps.Title }/>
			<input type="hidden" name="description" value={ taskWithDeps.Description }/>
			<input type="hidden" name="author" value={ taskWithDeps.Author }/>
			<div class="flex gap-2 mt-2">
				<button type="submit" class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
					Save
				</button>
				<button
					type="button"
					class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"
					onclick={ cancelEditField(fmt.Sprintf("duedate-%d", taskWithDeps.ID)) }
				>
					Cancel
				</button>
			</div>
		</form>
	</div>
}
