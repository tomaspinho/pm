package components

import (
	"fmt"
	"pm/internal/model"
)

templ AddTaskForm(columnID int64, orgID int64, projectID int64, labels []model.Label, members []model.User, currentUser model.User) {
	<form
		class="bg-white rounded-lg border border-gray-200 p-3 shadow-sm"
		hx-post={ fmt.Sprintf("/orgs/%d/projects/%d/tasks", orgID, projectID) }
		hx-target={ fmt.Sprintf("#task-list-%d", columnID) }
		hx-swap="beforeend"
		hx-disabled-elt="find button[type='submit']"
		data-column-id={ fmt.Sprintf("%d", columnID) }
		data-org-id={ fmt.Sprintf("%d", orgID) }
	>
		<input type="hidden" name="project_id" value={ intToStr(projectID) }/>
		<input type="hidden" name="columnID" value={ intToStr(columnID) }/>
		<div class="space-y-2">
			<input
				type="text"
				name="title"
				placeholder="Task title"
				required
				autofocus
				class="w-full px-2 py-1.5 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
			/>
			<textarea
				name="description"
				placeholder="Description (optional)"
				rows="2"
				class="w-full px-2 py-1.5 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
			></textarea>
			<div class="space-y-1">
				<label class="block text-xs font-medium text-gray-600">Due Date (optional)</label>
				<input
					type="date"
					name="due_date"
					onfocus="if(this.showPicker){try{this.showPicker()}catch(e){}}"
					class="w-full px-2 py-1.5 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				/>
			</div>
			<div class="space-y-1">
				<label class="block text-xs font-medium text-gray-600">Priority</label>
				<select
					name="priority"
					class="w-full px-2 py-1.5 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				>
					<option value="0">Urgent</option>
					<option value="1">High</option>
					<option value="2" selected>Medium</option>
					<option value="3">Low</option>
				</select>
			</div>
			if len(labels) > 0 {
				<div class="space-y-1" data-label-dropdown-container>
					<label class="block text-xs font-medium text-gray-600">Labels</label>
					<div class="flex flex-wrap gap-1" id={ fmt.Sprintf("selected-labels-%d", columnID) }></div>
					<div class="relative">
						<button
							type="button"
							class="text-xs text-indigo-600 hover:text-indigo-700 cursor-pointer add-task-label-toggle"
						>
							+ Add label
						</button>
						<div
							class="hidden absolute z-50 bg-white border border-gray-300 rounded-lg shadow-lg p-2 min-w-[200px] add-task-label-dropdown"
						>
							for _, label := range labels {
								<button
									type="button"
									class="w-full text-left px-3 py-2 rounded-lg flex items-center gap-2 transition-colors bg-gray-50 hover:bg-gray-100 border border-gray-200 cursor-pointer"
									data-label-id={ fmt.Sprintf("%d", label.ID) }
									data-label-name={ label.Name }
									data-label-color={ label.Color }
									data-column-id={ fmt.Sprintf("%d", columnID) }
									onclick="toggleTaskLabel(this)"
								>
									<span class="w-3 h-3 rounded-full flex-shrink-0" style={ "background-color: " + label.Color }></span>
									<span class="text-sm flex-1">{ label.Name }</span>
									<svg class="w-4 h-4 text-indigo-600 invisible flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" data-checkmark>
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
								</button>
							}
						</div>
					</div>
				</div>
			}
			<div class="space-y-1" data-assignee-container>
				<label class="block text-xs font-medium text-gray-600">Assignees</label>
				<div class="flex items-center gap-2 mb-1">
					<input
						type="checkbox"
						name="assign_me"
						id={ fmt.Sprintf("assign-me-%d", columnID) }
						class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded cursor-pointer"
					/>
					<label for={ fmt.Sprintf("assign-me-%d", columnID) } class="text-xs text-gray-700 cursor-pointer">
						Assign to me
					</label>
				</div>
				<div class="relative">
					<input
						type="text"
						placeholder="Search for a user..."
						class="w-full px-2 py-1.5 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent assignee-search-input"
						autocomplete="off"
					/>
					<div class="hidden absolute z-50 mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-48 overflow-y-auto w-full assignee-dropdown"></div>
				</div>
				<div class="flex flex-wrap gap-1 mt-1 selected-assignees"></div>
			</div>
			<div class="flex gap-2">
				<button
					type="submit"
					class="px-3 py-1.5 text-sm font-medium text-white bg-blue-600 rounded hover:bg-blue-700 transition-colors cursor-pointer"
				>
					Add Task
				</button>
				<button
					type="button"
					class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 rounded hover:bg-gray-200 transition-colors cursor-pointer"
					hx-get={ fmt.Sprintf("/orgs/%d/projects/%d/tasks/cancel-form?columnID=%d", orgID, projectID, columnID) }
					hx-target={ fmt.Sprintf("#add-form-%d", columnID) }
					hx-swap="innerHTML"
				>
					Cancel
				</button>
			</div>
		</div>
	</form>
	<script>
		function toggleTaskLabel(btn) {
			var labelID = btn.getAttribute('data-label-id');
			var labelName = btn.getAttribute('data-label-name');
			var labelColor = btn.getAttribute('data-label-color');
			var columnID = btn.getAttribute('data-column-id');
			var selectedContainer = document.getElementById('selected-labels-' + columnID);
			var existing = selectedContainer.querySelector('[data-label-id="' + labelID + '"]');
			var checkmark = btn.querySelector('[data-checkmark]');
			
			if (existing) {
				existing.remove();
				btn.classList.remove('bg-indigo-100', 'border-indigo-200', 'hover:bg-indigo-100');
				btn.classList.add('bg-gray-50', 'hover:bg-gray-100', 'border-gray-200');
				checkmark.classList.add('invisible');
			} else {
				var chip = document.createElement('span');
				chip.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium border';
				chip.style.backgroundColor = labelColor;
				chip.style.color = 'white';
				chip.style.borderColor = 'rgba(255,255,255,0.2)';
				chip.setAttribute('data-label-id', labelID);
				chip.innerHTML = labelName + ' <input type="hidden" name="label_ids" value="' + labelID + '"><span class="cursor-pointer hover:text-white/80 ml-1" onclick="removeLabelChip(this, ' + labelID + ', ' + columnID + ')">&times;</span>';
				selectedContainer.appendChild(chip);
				btn.classList.remove('bg-gray-50', 'hover:bg-gray-100', 'border-gray-200');
				btn.classList.add('bg-indigo-100', 'hover:bg-indigo-100', 'border-indigo-200');
				checkmark.classList.remove('invisible');
			}
		}

		function removeLabelChip(el, labelID, columnID) {
			var chip = el.parentElement;
			chip.remove();
			var dropdown = document.querySelector('[data-label-dropdown-container] .add-task-label-dropdown');
			if (dropdown) {
				var btn = dropdown.querySelector('[data-label-id="' + labelID + '"]');
				if (btn) {
					var checkmark = btn.querySelector('[data-checkmark]');
					btn.classList.remove('bg-indigo-100', 'border-indigo-200', 'hover:bg-indigo-100');
					btn.classList.add('bg-gray-50', 'hover:bg-gray-100', 'border-gray-200');
					if (checkmark) checkmark.classList.add('invisible');
				}
			}
		}

		(function() {
			var labelContainers = document.querySelectorAll('[data-label-dropdown-container]');
			labelContainers.forEach(function(container) {
				var toggleBtn = container.querySelector('.add-task-label-toggle');
				var dropdown = container.querySelector('.add-task-label-dropdown');

				toggleBtn.addEventListener('click', function(e) {
					var wasHidden = dropdown.classList.contains('hidden');
					dropdown.classList.toggle('hidden');

					if (wasHidden) {
						var rect = toggleBtn.getBoundingClientRect();
						dropdown.style.position = 'fixed';
						dropdown.style.left = rect.left + 'px';
						dropdown.style.top = (rect.bottom + 5) + 'px';
						dropdown.style.maxHeight = '200px';
						dropdown.style.overflowY = 'auto';

						function hideDropdown(event) {
							if (!dropdown.contains(event.target) && !toggleBtn.contains(event.target)) {
								dropdown.classList.add('hidden');
								document.removeEventListener('click', hideDropdown);
							}
						}
						e.stopPropagation();
						setTimeout(function() {
							document.addEventListener('click', hideDropdown);
						}, 0);
					}
				});
			});
		})();

		(function() {
			var containers = document.querySelectorAll('[data-assignee-container]');
			containers.forEach(function(container) {
				var form = container.closest('form');
				var orgID = form.getAttribute('data-org-id');
				var searchInput = container.querySelector('.assignee-search-input');
				var dropdown = container.querySelector('.assignee-dropdown');
				var selectedContainer = container.querySelector('.selected-assignees');
				var searchDebounce = null;

				function getAvatarColor(email) {
					var hash = 0;
					for (var i = 0; i < email.length; i++) {
						hash = email.charCodeAt(i) + ((hash << 5) - hash);
					}
					var colors = ['#6366f1', '#8b5cf6', '#ec4899', '#f59e0b', '#10b981', '#06b6d4', '#3b82f6'];
					return colors[Math.abs(hash) % colors.length];
				}

				function getInitials(name) {
					if (!name) return '??';
					var parts = name.trim().split(/\s+/);
					if (parts.length >= 2) {
						return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
					}
					return name.substring(0, 2).toUpperCase();
				}

				searchInput.addEventListener('input', function(e) {
					clearTimeout(searchDebounce);
					var query = e.target.value.trim();
					searchDebounce = setTimeout(function() {
						if (query.length < 1) {
							dropdown.classList.add('hidden');
							return;
						}
						fetch('/orgs/' + orgID + '/users/search?q=' + encodeURIComponent(query))
							.then(function(res) { return res.json(); })
							.then(function(users) {
								dropdown.innerHTML = '';
								users.forEach(function(user) {
									var btn = document.createElement('button');
									btn.type = 'button';
									btn.className = 'w-full text-left px-2 py-1.5 hover:bg-gray-100 flex items-center gap-2 text-sm cursor-pointer';
									btn.onclick = function() {
										if (!selectedContainer.querySelector('[data-user-id="' + user.id + '"]')) {
											var chip = document.createElement('span');
											chip.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700';
											chip.setAttribute('data-user-id', user.id);
											chip.innerHTML = '<span class="w-4 h-4 rounded-full flex items-center justify-center text-white text-xs" style="background-color:' + getAvatarColor(user.email) + '">' + getInitials(user.display_name || user.email) + '</span>' + (user.display_name || user.email) + ' <input type="hidden" name="assignee_ids" value="' + user.id + '"><span class="cursor-pointer hover:opacity-70" onclick="this.parentElement.remove()">&times;</span>';
											selectedContainer.appendChild(chip);
										}
										dropdown.classList.add('hidden');
										searchInput.value = '';
									};
									btn.innerHTML = '<span class="w-5 h-5 rounded-full flex items-center justify-center text-white text-xs" style="background-color:' + getAvatarColor(user.email) + '">' + getInitials(user.display_name || user.email) + '</span><span>' + (user.display_name || user.email) + '</span>';
									dropdown.appendChild(btn);
								});
								dropdown.classList.remove('hidden');
							});
					}, 200);
				});

				document.addEventListener('click', function(e) {
					if (!dropdown.contains(e.target) && !searchInput.contains(e.target)) {
						dropdown.classList.add('hidden');
					}
				});
			});
		})();
	</script>
}

func intToStr(n int64) string {
	return fmt.Sprintf("%d", n)
}