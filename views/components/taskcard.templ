package components

import (
	"pm/internal/model"
	"fmt"
)

// Helper function to get due date badge class
func dueDateBadgeClass(task model.Task) string {
	if task.IsOverdue() {
		return "bg-red-100 text-red-700 border-red-300"
	}
	if task.IsDueSoon() {
		return "bg-yellow-100 text-yellow-700 border-yellow-300"
	}
	return "bg-gray-100 text-gray-600 border-gray-300"
}

templ TaskCard(task model.Task, orgID int64) {
	<div
		class="task-card bg-white rounded-lg shadow-sm border border-gray-200 p-3 cursor-grab active:cursor-grabbing hover:shadow-md transition-all duration-150"
		data-id={ fmt.Sprintf("%d", task.ID) }
		data-org-id={ fmt.Sprintf("%d", orgID) }
		data-project-id={ fmt.Sprintf("%d", task.ProjectID) }
		id={ "task-" + fmt.Sprintf("%d", task.ID) }
	>
		<div class="flex items-start gap-2">
			<span class="drag-handle mt-0.5 text-gray-300 hover:text-gray-500 transition-colors shrink-0">
				<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16">
					<circle cx="4" cy="3" r="1.5"></circle>
					<circle cx="4" cy="8" r="1.5"></circle>
					<circle cx="4" cy="13" r="1.5"></circle>
					<circle cx="10" cy="3" r="1.5"></circle>
					<circle cx="10" cy="8" r="1.5"></circle>
					<circle cx="10" cy="13" r="1.5"></circle>
				</svg>
			</span>
			<div
				class="flex-1 min-w-0 cursor-pointer task-card-content"
				hx-get={ fmt.Sprintf("/orgs/%d/projects/%d/tasks/%d/detail", orgID, task.ProjectID, task.ID) }
				hx-target="body"
				hx-swap="beforeend"
				data-url={ fmt.Sprintf("/orgs/%d/projects/%d/tasks/%d", orgID, task.ProjectID, task.ID) }
				hx-on::after-request="history.pushState(null, '', this.dataset.url)"
			>
				<p class="text-sm font-medium text-gray-900 truncate">{ task.Title }</p>
				if task.DueDate != nil {
					<div class={ "text-xs px-2 py-0.5 rounded-full border inline-flex items-center gap-1 mt-1", dueDateBadgeClass(task) }>
						<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
						</svg>
						<span>{ task.DueDate.Format("Jan 2") }</span>
					</div>
				}
				if task.Description != "" {
					<p class="text-xs text-gray-500 mt-1 line-clamp-2">{ task.Description }</p>
				}
			</div>
			<button
				type="button"
				class="delete-btn shrink-0 text-gray-400 hover:text-red-500 transition-colors cursor-pointer"
				hx-delete={ fmt.Sprintf("/orgs/%d/projects/%d/tasks/%d", orgID, task.ProjectID, task.ID) }
				hx-target={ "#task-" + fmt.Sprintf("%d", task.ID) }
				hx-swap="outerHTML swap:1s"
				data-confirm-delete="true"
				data-task-column-id={ fmt.Sprintf("%d", task.ColumnID) }
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
			</button>
		</div>
	</div>
}
