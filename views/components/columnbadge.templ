package components

import (
	"fmt"
	"pm/internal/model"
)

// ColumnBadgeOOB wraps ColumnBadge with hx-swap-oob for out-of-band updates.
templ ColumnBadgeOOB(taskWithDeps model.TaskWithDependencies, orgID int64, columns []model.ProjectColumn) {
	<div id="column-badge" hx-swap-oob="true">
		@ColumnBadge(taskWithDeps, orgID, columns)
	</div>
}

// ColumnBadge renders the column status display with a dropdown for changing columns.
templ ColumnBadge(taskWithDeps model.TaskWithDependencies, orgID int64, columns []model.ProjectColumn) {
	<div 
		id="column-badge" 
		class="space-y-2 relative" 
		data-task-id={ fmt.Sprintf("%d", taskWithDeps.ID) }
		data-org-id={ fmt.Sprintf("%d", orgID) }
		data-project-id={ fmt.Sprintf("%d", taskWithDeps.ProjectID) }
		data-current-column-id={ fmt.Sprintf("%d", taskWithDeps.ColumnID) }
	>
		<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide">Column</label>
		<div class="relative inline-block">
			<button
				type="button"
				class="inline-flex items-center gap-2 px-3 py-2 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg transition-colors cursor-pointer"
				onclick="toggleColumnDropdown(this)"
			>
				<span 
					class="w-3 h-3 rounded-full flex-shrink-0"
					style={ "background-color: " + taskWithDeps.ColumnColor }
				></span>
				<span class="text-sm font-medium text-gray-700">{ taskWithDeps.ColumnName }</span>
				<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
				</svg>
			</button>
			<div class="column-dropdown hidden fixed z-50 bg-white border border-gray-300 rounded-lg shadow-lg p-2 min-w-[180px] max-h-[240px] overflow-y-auto">
				<div class="space-y-1">
					for _, column := range columns {
						@ColumnDropdownItem(taskWithDeps.ID, taskWithDeps.ColumnID, column, orgID, taskWithDeps.ProjectID)
					}
				</div>
			</div>
		</div>
	</div>
	<script>
		function toggleColumnDropdown(btn) {
			var container = btn.closest('#column-badge');
			var dropdown = container.querySelector('.column-dropdown');
			var wasHidden = dropdown.classList.contains('hidden');

			document.querySelectorAll('.column-dropdown').forEach(function(dd) {
				if (dd !== dropdown) dd.classList.add('hidden');
			});

			dropdown.classList.toggle('hidden');

			if (wasHidden) {
				var rect = btn.getBoundingClientRect();
				dropdown.style.left = rect.left + 'px';
				dropdown.style.top = (rect.bottom + 5) + 'px';

				function hideDropdown(event) {
					if (!dropdown.contains(event.target) && !btn.contains(event.target)) {
						dropdown.classList.add('hidden');
						document.removeEventListener('click', hideDropdown);
					}
				}
				setTimeout(function() {
					document.addEventListener('click', hideDropdown);
				}, 0);
			}
		}

		function selectColumn(btn) {
			var container = btn.closest('#column-badge');
			var taskID = container.getAttribute('data-task-id');
			var orgID = container.getAttribute('data-org-id');
			var projectID = container.getAttribute('data-project-id');
			var columnID = btn.getAttribute('data-column-id');

			var url = '/orgs/' + orgID + '/projects/' + projectID + '/tasks/' + taskID + '/column';

			fetch(url, {
				method: 'PATCH',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: 'columnID=' + columnID
			})
			.then(function(response) {
				if (!response.ok) {
					alert('Failed to update column');
					return;
				}
				return response.text();
			})
			.then(function(html) {
				if (!html) return;
				var parser = new DOMParser();
				var doc = parser.parseFromString(html, 'text/html');
				
				doc.querySelectorAll('[hx-swap-oob="true"]').forEach(function(el) {
					var targetId = el.id;
					var existing = document.getElementById(targetId);
					if (existing) {
						existing.outerHTML = el.outerHTML;
					}
				});

				if (window.Sortable) {
					document.querySelectorAll('.sortable-column').forEach(function(col) {
						if (!col.sortableInstance) {
							col.sortableInstance = new Sortable(col, {
								group: 'kanban',
								animation: 200,
								easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
								ghostClass: 'task-ghost',
								chosenClass: 'task-chosen',
								dragClass: 'task-drag',
								handle: '.drag-handle',
								emptyInsertThreshold: 30,
								onStart: function() {
									document.querySelectorAll('.sortable-column').forEach(function(c) {
										c.classList.add('drop-target');
									});
								},
								onEnd: function(evt) {
									document.querySelectorAll('.sortable-column').forEach(function(c) {
										c.classList.remove('drop-target');
									});
									var taskId = evt.item.dataset.id;
									var newColumnID = evt.to.dataset.columnId;
									var newPosition = evt.newIndex;
									var dataOrgId = document.getElementById('kanban-data').getAttribute('data-org-id');
									var dataProjectId = document.getElementById('kanban-data').getAttribute('data-project-id');
									htmx.ajax('PATCH', '/orgs/' + dataOrgId + '/projects/' + dataProjectId + '/tasks/' + taskId + '/move', {
										values: { columnID: newColumnID, position: newPosition },
										swap: 'none'
									});
								}
							});
						}
					});
				}
			})
			.catch(function() {
				alert('Failed to update column');
			});
		}
	</script>
}

// ColumnDropdownItem renders a single column option in the dropdown.
templ ColumnDropdownItem(taskID int64, currentColumnID int64, column model.ProjectColumn, orgID int64, projectID int64) {
	<button
		type="button"
		class={ "w-full text-left px-3 py-2 rounded-lg flex items-center gap-2 cursor-pointer " + columnItemClass(currentColumnID, column.ID) }
		data-column-id={ fmt.Sprintf("%d", column.ID) }
		data-column-name={ column.Name }
		data-column-color={ column.Color }
		onclick="selectColumn(this)"
	>
		<span class="w-3 h-3 rounded-full flex-shrink-0" style={ "background-color: " + column.Color }></span>
		<span class="text-sm flex-1">{ column.Name }</span>
		if currentColumnID == column.ID {
			<svg class="w-4 h-4 text-indigo-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
			</svg>
		}
	</button>
}

func columnItemClass(currentColumnID int64, columnID int64) string {
	if currentColumnID == columnID {
		return "bg-indigo-100 border border-indigo-200"
	}
	return "bg-gray-50 hover:bg-gray-100 border border-gray-200"
}