package views

import (
	"fmt"
	"strconv"

	"pm/internal/model"
	"pm/views/components"
)

templ BoardPage(project model.Project, columns []model.ProjectColumn, tasksByColumn map[int64][]model.Task, labels []model.Label, tasksWithLabels map[int64][]model.Label, tasksWithAssignees map[int64][]model.AssigneeInfo, nav NavContext) {
	@BoardLayout(project.Name, nav) {
		<!-- Project Header - Left Aligned with Settings Button -->
		<div class="flex-shrink-0 py-6">
			<div class="max-w-7xl mx-auto px-4 flex items-start justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900">{ project.Name }</h1>
					if project.Description != "" {
						<p class="mt-1 text-gray-500">{ project.Description }</p>
					}
				</div>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d/settings", nav.CurrentOrgID, project.ID)) }
					class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:text-gray-900 transition-colors cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					</svg>
					Settings
				</a>
			</div>
		</div>
		if len(columns) == 0 {
			<!-- Empty State - Centered -->
			<div class="flex-1 flex items-center justify-center">
				<div class="max-w-7xl mx-auto px-4">
					@EmptyColumnsState(project, nav.CurrentOrgID)
				</div>
			</div>
		} else {
			<!-- Kanban Board - Horizontally Scrollable, fills remaining height -->
			<div class="flex-1 overflow-x-auto overflow-y-auto">
				<div class="max-w-7xl mx-auto px-4 h-full">
					<div
						id="kanban-board"
						class="grid gap-6 min-w-max h-full pb-4"
						style={ templ.SafeCSS(fmt.Sprintf("grid-template-columns: repeat(%d, 320px)", len(columns))) }
					>
						for _, column := range columns {
							@Column(column, project, tasksByColumn[column.ID], tasksWithLabels, tasksWithAssignees)
						}
					</div>
				</div>
			</div>
			<!-- Data for kanban script -->
			<div id="kanban-data" style="display:none" data-org-id={ fmt.Sprintf("%d", project.OrganizationID) } data-project-id={ fmt.Sprintf("%d", project.ID) }></div>
			@kanbanScript()
		}
	}
}

templ EmptyColumnsState(project model.Project, orgID int64) {
	<div class="flex items-center justify-center py-16">
		<div class="text-center max-w-md">
			<div class="mb-6">
				<svg class="w-24 h-24 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
				</svg>
			</div>
			<h2 class="text-xl font-semibold text-gray-900 mb-2">No columns yet</h2>
			<p class="text-gray-600 mb-6">
				Set up your workflow columns to start organizing tasks.
			</p>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d/columns/setup", orgID, project.ID)) }
				class="inline-block px-6 py-3 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors"
			>
				Set Up Columns
			</a>
		</div>
	</div>
}

templ Column(column model.ProjectColumn, project model.Project, tasks []model.Task, tasksWithLabels map[int64][]model.Label, tasksWithAssignees map[int64][]model.AssigneeInfo) {
	<div class="flex flex-col min-w-0">
		<div class="flex items-center gap-2 mb-3">
			<div
				class="w-3 h-3 rounded-full shrink-0"
				style={ templ.SafeCSS(fmt.Sprintf("background-color: %s", column.Color)) }
			></div>
			<h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">
				{ column.Name }
			</h2>
			<span
				id={ fmt.Sprintf("count-%d", column.ID) }
				class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5"
			>
				{ intToStr(len(tasks)) }
			</span>
		</div>
		<div
			id={ fmt.Sprintf("task-list-%d", column.ID) }
			class="sortable-column flex flex-col gap-2 min-h-[120px] rounded-lg bg-gray-100/50 border border-transparent transition-all duration-200"
			data-column-id={ fmt.Sprintf("%d", column.ID) }
		>
			for _, task := range tasks {
				@components.TaskCard(task, tasksWithLabels[task.ID], tasksWithAssignees[task.ID], project.OrganizationID, false)
			}
		</div>
		<div id={ fmt.Sprintf("add-form-%d", column.ID) } class="mt-2">
			@components.AddTaskButton(column.ID, project.OrganizationID, project.ID)
		</div>
	</div>
}

templ kanbanScript() {
	<script>
	(function() {
		// Load data from data attributes
		var dataEl = document.getElementById('kanban-data');
		var orgID = dataEl.getAttribute('data-org-id');
		var projectID = dataEl.getAttribute('data-project-id');

		function initKanban() {
			var columns = document.querySelectorAll(".sortable-column");

			columns.forEach(function(col) {
				// Destroy existing instance if it exists (important for htmx OOB swaps)
				if (col.sortableInstance) {
					col.sortableInstance.destroy();
					delete col.sortableInstance;
				}

				// Create new Sortable instance
				col.sortableInstance = new Sortable(col, {
					group: "kanban",
					animation: 200,
					easing: "cubic-bezier(0.25, 1, 0.5, 1)",
					ghostClass: "task-ghost",
					chosenClass: "task-chosen",
					dragClass: "task-drag",
					handle: ".drag-handle",
					emptyInsertThreshold: 30,
					forceFallback: false,
					onStart: function() {
						document.querySelectorAll(".sortable-column").forEach(function(c) {
							c.classList.add("drop-target");
						});
					},
					onEnd: function(evt) {
						document.querySelectorAll(".sortable-column").forEach(function(c) {
							c.classList.remove("drop-target");
						});

						var taskId = evt.item.dataset.id;
						var newColumnID = evt.to.dataset.columnId;
						var newPosition = evt.newIndex;

						htmx.ajax("PATCH", "/orgs/" + orgID + "/projects/" + projectID + "/tasks/" + taskId + "/move", {
							values: {
								columnID: newColumnID,
								position: newPosition
							},
							swap: "none"
						});
					}
				});
			});
		}

		initKanban();

		// Only load task from URL if pane doesn't already exist
		if (!document.getElementById("detail-pane")) {
			var urlTaskId = window.location.pathname.match(/\/tasks\/(\d+)/);
			if (urlTaskId && urlTaskId[1]) {
				var taskId = urlTaskId[1];
				var url = "/orgs/" + orgID + "/projects/" + projectID + "/tasks/" + taskId + "/detail";
				htmx.ajax("GET", url, {
					swap: "beforeend",
					target: "body"
				});
			}
		}
		document.addEventListener("htmx:afterSwap", initKanban);
	})();
	</script>
}

func intToStr(n int) string {
	return fmt.Sprintf("%d", n)
}

// NewTaskResponse returns the new task card plus out-of-band updates.
templ NewTaskResponse(task model.Task, orgID int64, columnID int64, count int, labels []model.Label, assignees []model.AssigneeInfo) {
	@components.TaskCard(task, labels, assignees, orgID, false)
	<!-- Out-of-band: update count -->
	<span id={ fmt.Sprintf("count-%d", columnID) } hx-swap-oob="true" class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5">
		{ intToStr(count) }
	</span>
	<!-- Out-of-band: reset form to button -->
	<div id={ fmt.Sprintf("add-form-%d", columnID) } hx-swap-oob="true" class="mt-2">
		@components.AddTaskButton(columnID, orgID, task.ProjectID)
	</div>
}

// DeleteTaskResponse returns out-of-band count update after deletion.
templ DeleteTaskResponse(columnID int64, count int) {
	<span id={ fmt.Sprintf("count-%d", columnID) } hx-swap-oob="true" class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5">
		{ intToStr(count) }
	</span>
}

// TaskDetailPane wraps the component for use in handlers.
templ TaskDetailPane(taskWithDeps model.TaskWithDependencies, orgID int64, projectID int64, columns []model.ProjectColumn, comments []model.CommentThread, currentUser *model.User, activity []model.TaskActivityRecord, labels []model.Label, allLabels []model.Label) {
	@components.TaskDetailPane(taskWithDeps, orgID, projectID, columns, comments, currentUser, activity, labels, allLabels)
}

// DependencySection wraps the component for use in handlers.
templ DependencySection(taskWithDeps model.TaskWithDependencies, orgID int64) {
	@components.DependencySection(taskWithDeps, orgID)
}

// DependencySectionWithActivity returns dependency section and activity section OOB.
templ DependencySectionWithActivity(taskWithDeps model.TaskWithDependencies, orgID int64, activity []model.TaskActivityRecord) {
	@components.DependencySection(taskWithDeps, orgID)
	@components.ActivitySection(taskWithDeps.ID, orgID, activity)
}

// MetadataSection wraps the component for use in handlers.
templ MetadataSection(taskID int64, orgID int64, projectID int64, metadata model.TaskMetadata) {
	@components.MetadataSection(taskID, orgID, projectID, metadata)
}

// MetadataSectionWithActivity returns metadata section and activity section OOB.
templ MetadataSectionWithActivity(taskID int64, orgID int64, projectID int64, metadata model.TaskMetadata, activity []model.TaskActivityRecord) {
	@components.MetadataSection(taskID, orgID, projectID, metadata)
	@components.ActivitySection(taskID, orgID, activity)
}

// TaskFieldUpdateResponse returns the updated task card with OOB swap for the kanban board.
templ TaskFieldUpdateResponse(taskWithDeps model.TaskWithDependencies, orgID int64, labels []model.Label, assignees []model.AssigneeInfo) {
	@components.TaskCard(taskWithDeps.Task, labels, assignees, orgID, true)
}

// TaskFieldSectionUpdate returns the field section and task card OOB update.
templ TaskFieldSectionUpdate(taskWithDeps model.TaskWithDependencies, orgID int64, labels []model.Label, assignees []model.AssigneeInfo, field string) {
	switch field {
	case "title":
		@components.TitleSection(taskWithDeps, orgID, false)
	case "description":
		@components.DescriptionSection(taskWithDeps, orgID, false)
	case "due_date":
		@components.DueDateSection(taskWithDeps, orgID, false)
	case "priority":
		@components.PrioritySection(taskWithDeps, orgID, false)
	}
	@components.TaskCard(taskWithDeps.Task, labels, assignees, orgID, true)
}

// TaskFieldUpdateWithActivityResponse returns field section, task card, and activity section OOB.
templ TaskFieldUpdateWithActivityResponse(taskWithDeps model.TaskWithDependencies, orgID int64, labels []model.Label, assignees []model.AssigneeInfo, field string, activity []model.TaskActivityRecord) {
	switch field {
	case "title":
		@components.TitleSection(taskWithDeps, orgID, false)
	case "description":
		@components.DescriptionSection(taskWithDeps, orgID, false)
	case "due_date":
		@components.DueDateSection(taskWithDeps, orgID, false)
	case "priority":
		@components.PrioritySection(taskWithDeps, orgID, false)
	}
	@components.TaskCard(taskWithDeps.Task, labels, assignees, orgID, true)
	@components.ActivitySection(taskWithDeps.ID, orgID, activity)
}

// LabelTaskCardUpdate returns only the task card with OOB swap for label changes.
templ LabelTaskCardUpdate(task model.Task, orgID int64, labels []model.Label, assignees []model.AssigneeInfo) {
	@components.TaskCard(task, labels, assignees, orgID, true)
}

// LabelTaskCardUpdateWithActivity returns task card and activity section OOB for label changes.
templ LabelTaskCardUpdateWithActivity(task model.Task, orgID int64, labels []model.Label, assignees []model.AssigneeInfo, activity []model.TaskActivityRecord) {
	@components.TaskCard(task, labels, assignees, orgID, true)
	@components.ActivitySection(task.ID, orgID, activity)
}

// AssigneeUpdateResponse returns the assignee section and task card OOB update.
templ AssigneeUpdateResponse(taskID int64, assignees []model.AssigneeInfo, orgID int64, projectID int64, currentUser model.User, task model.Task, labels []model.Label) {
	@components.AssigneeSection(taskID, assignees, orgID, projectID, currentUser)
	@components.TaskCard(task, labels, assignees, orgID, true)
}

// AssigneeUpdateResponseWithActivity returns assignee section, task card, and activity section OOB.
templ AssigneeUpdateResponseWithActivity(taskID int64, assignees []model.AssigneeInfo, orgID int64, projectID int64, currentUser model.User, task model.Task, labels []model.Label, activity []model.TaskActivityRecord) {
	@components.AssigneeSection(taskID, assignees, orgID, projectID, currentUser)
	@components.TaskCard(task, labels, assignees, orgID, true)
	@components.ActivitySection(taskID, orgID, activity)
}

// ColumnUpdateResponse returns OOB updates for column badge and kanban columns (no full pane reload).
templ ColumnUpdateResponse(taskWithDeps model.TaskWithDependencies, orgID int64, oldColumnID int64, tasksByColumn map[int64][]model.Task, tasksWithLabels map[int64][]model.Label, tasksWithAssignees map[int64][]model.AssigneeInfo, columns []model.ProjectColumn) {
	<!-- Out-of-band: update column badge -->
	@components.ColumnBadgeOOB(taskWithDeps, orgID, columns)
	if oldColumnID != taskWithDeps.ColumnID {
		<!-- Out-of-band: update old column task list -->
		<div
			id={ fmt.Sprintf("task-list-%d", oldColumnID) }
			class="sortable-column flex flex-col gap-2 min-h-[120px] p-2 rounded-lg bg-gray-100/50 border border-transparent transition-all duration-200"
			data-column-id={ strconv.FormatInt(oldColumnID, 10) }
			hx-swap-oob="true"
		>
			for _, task := range tasksByColumn[oldColumnID] {
				@components.TaskCard(task, tasksWithLabels[task.ID], tasksWithAssignees[task.ID], orgID, false)
			}
		</div>
		<!-- Out-of-band: update old column count -->
		<span
			id={ fmt.Sprintf("count-%d", oldColumnID) }
			class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5"
			hx-swap-oob="true"
		>
			{ intToStr(len(tasksByColumn[oldColumnID])) }
		</span>
	}
	<!-- Out-of-band: update new column task list -->
	<div
		id={ fmt.Sprintf("task-list-%d", taskWithDeps.ColumnID) }
		class="sortable-column flex flex-col gap-2 min-h-[120px] p-2 rounded-lg bg-gray-100/50 border border-transparent transition-all duration-200"
		data-column-id={ strconv.FormatInt(taskWithDeps.ColumnID, 10) }
		hx-swap-oob="true"
	>
		for _, task := range tasksByColumn[taskWithDeps.ColumnID] {
			@components.TaskCard(task, tasksWithLabels[task.ID], tasksWithAssignees[task.ID], orgID, false)
		}
	</div>
	<!-- Out-of-band: update new column count -->
	<span
		id={ fmt.Sprintf("count-%d", taskWithDeps.ColumnID) }
		class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5"
		hx-swap-oob="true"
	>
		{ intToStr(len(tasksByColumn[taskWithDeps.ColumnID])) }
	</span>
}

// BoardPageWithTask renders the board with a task's detail pane pre-opened.
templ BoardPageWithTask(project model.Project, columns []model.ProjectColumn, tasksByColumn map[int64][]model.Task, tasksWithLabels map[int64][]model.Label, tasksWithAssignees map[int64][]model.AssigneeInfo, allLabels []model.Label, nav NavContext, taskWithDeps *model.TaskWithDependencies, comments []model.CommentThread, user *model.User, taskLabels []model.Label, activity []model.TaskActivityRecord) {
	@BoardLayout(project.Name, nav) {
		<div class="flex-shrink-0 py-6">
			<div class="max-w-7xl mx-auto px-4 flex items-start justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900">{ project.Name }</h1>
					if project.Description != "" {
						<p class="mt-1 text-gray-500">{ project.Description }</p>
					}
				</div>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d/settings", nav.CurrentOrgID, project.ID)) }
					class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 hover:text-gray-900 transition-colors cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
					</svg>
					Settings
				</a>
			</div>
		</div>
		if len(columns) == 0 {
			<div class="flex-1 flex items-center justify-center">
				<div class="max-w-7xl mx-auto px-4">
					@EmptyColumnsState(project, nav.CurrentOrgID)
				</div>
			</div>
		} else {
			<div class="flex-1 overflow-x-auto overflow-y-auto">
				<div class="max-w-7xl mx-auto px-4 h-full">
					<div
						id="kanban-board"
						class="grid gap-6 min-w-max h-full pb-4"
						style={ templ.SafeCSS(fmt.Sprintf("grid-template-columns: repeat(%d, 320px)", len(columns))) }
					>
						for _, column := range columns {
							@Column(column, project, tasksByColumn[column.ID], tasksWithLabels, tasksWithAssignees)
						}
					</div>
				</div>
			</div>
			<div id="kanban-data" style="display:none" data-org-id={ fmt.Sprintf("%d", project.OrganizationID) } data-project-id={ fmt.Sprintf("%d", project.ID) } data-task-id={ fmt.Sprintf("%d", taskWithDeps.ID) }></div>
		}
		<!-- Detail pane for pre-opened task -->
		@TaskDetailPane(*taskWithDeps, nav.CurrentOrgID, project.ID, columns, comments, user, activity, taskLabels, allLabels)
	}
}
