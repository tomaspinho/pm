package views

import (
	"fmt"
	"strconv"

	"pm/internal/model"
	"pm/views/components"
)

templ BoardPage(project model.Project, columns []model.ProjectColumn, tasksByColumn map[int64][]model.Task, nav NavContext) {
	@BoardLayout(project.Name, nav) {
		<!-- Project Header - Left Aligned -->
		<div class="flex-shrink-0 py-6">
			<div class="max-w-7xl mx-auto px-4">
				<h1 class="text-2xl font-bold text-gray-900">{ project.Name }</h1>
				if project.Description != "" {
					<p class="mt-1 text-gray-500">{ project.Description }</p>
				}
			</div>
		</div>
		if len(columns) == 0 {
			<!-- Empty State - Centered -->
			<div class="flex-1 flex items-center justify-center">
				<div class="max-w-7xl mx-auto px-4">
					@EmptyColumnsState(project, nav.CurrentOrgID)
				</div>
			</div>
		} else {
			<!-- Kanban Board - Horizontally Scrollable, fills remaining height -->
			<div class="flex-1 overflow-x-auto overflow-y-auto">
				<div class="max-w-7xl mx-auto px-4 h-full">
					<div 
						id="kanban-board" 
						class="grid gap-6 min-w-max h-full pb-4"
						style={ templ.SafeCSS(fmt.Sprintf("grid-template-columns: repeat(%d, 320px)", len(columns))) }
					>
						for _, column := range columns {
							@Column(column, project, tasksByColumn[column.ID])
						}
					</div>
				</div>
			</div>
			@kanbanScript(project.OrganizationID, project.ID)
		}
	}
}

templ EmptyColumnsState(project model.Project, orgID int64) {
	<div class="flex items-center justify-center py-16">
		<div class="text-center max-w-md">
			<div class="mb-6">
				<svg class="w-24 h-24 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
				</svg>
			</div>
			<h2 class="text-xl font-semibold text-gray-900 mb-2">No columns yet</h2>
			<p class="text-gray-600 mb-6">
				Set up your workflow columns to start organizing tasks.
			</p>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/orgs/%d/projects/%d/columns/setup", orgID, project.ID)) }
				class="inline-block px-6 py-3 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors"
			>
				Set Up Columns
			</a>
		</div>
	</div>
}

templ Column(column model.ProjectColumn, project model.Project, tasks []model.Task) {
	<div class="flex flex-col min-w-0">
		<div class="flex items-center gap-2 mb-3">
			<div 
				class="w-3 h-3 rounded-full shrink-0" 
				style={ templ.SafeCSS(fmt.Sprintf("background-color: %s", column.Color)) }
			></div>
			<h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">
				{ column.Name }
			</h2>
			<span
				id={ fmt.Sprintf("count-%d", column.ID) }
				class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5"
			>
				{ intToStr(len(tasks)) }
			</span>
		</div>
		<div
			id={ fmt.Sprintf("task-list-%d", column.ID) }
			class="sortable-column flex flex-col gap-2 min-h-[120px] p-2 rounded-lg bg-gray-100/50 border border-transparent transition-all duration-200"
			data-column-id={ fmt.Sprintf("%d", column.ID) }
		>
			for _, task := range tasks {
				@components.TaskCard(task, project.OrganizationID)
			}
		</div>
		<div id={ fmt.Sprintf("add-form-%d", column.ID) } class="mt-2">
			@components.AddTaskButton(column.ID, project.OrganizationID, project.ID)
		</div>
	</div>
}

templ kanbanScript(orgID int64, projectID int64) {
	<script>
	(function() {
		var orgID = { fmt.Sprintf("%d", orgID) };
		var projectID = { fmt.Sprintf("%d", projectID) };

		function initKanban() {
			var columns = document.querySelectorAll(".sortable-column");
			columns.forEach(function(col) {
				if (col.sortableInstance) return;
				col.sortableInstance = new Sortable(col, {
					group: "kanban",
					animation: 200,
					easing: "cubic-bezier(0.25, 1, 0.5, 1)",
					ghostClass: "task-ghost",
					chosenClass: "task-chosen",
					dragClass: "task-drag",
					handle: ".drag-handle",
					emptyInsertThreshold: 30,
					forceFallback: false,
					onStart: function() {
						document.querySelectorAll(".sortable-column").forEach(function(c) {
							c.classList.add("drop-target");
						});
					},
					onEnd: function(evt) {
						document.querySelectorAll(".sortable-column").forEach(function(c) {
							c.classList.remove("drop-target");
						});

						var taskId = evt.item.dataset.id;
						var newColumnID = evt.to.dataset.columnId;
						var newPosition = evt.newIndex;

						htmx.ajax("PATCH", "/orgs/" + orgID + "/projects/" + projectID + "/tasks/" + taskId + "/move", {
							values: {
								columnID: newColumnID,
								position: newPosition
							},
							swap: "none"
						});
					}
				});
			});
		}

		initKanban();
		document.addEventListener("htmx:afterSwap", initKanban);
	})();
	</script>
}

func intToStr(n int) string {
	return fmt.Sprintf("%d", n)
}

// NewTaskResponse returns the new task card plus out-of-band updates.
templ NewTaskResponse(task model.Task, orgID int64, columnID int64, count int) {
	@components.TaskCard(task, orgID)
	<!-- Out-of-band: update count -->
	<span id={ fmt.Sprintf("count-%d", columnID) } hx-swap-oob="true" class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5">
		{ intToStr(count) }
	</span>
	<!-- Out-of-band: reset form to button -->
	<div id={ fmt.Sprintf("add-form-%d", columnID) } hx-swap-oob="true" class="mt-2">
		@components.AddTaskButton(columnID, orgID, task.ProjectID)
	</div>
}

// DeleteTaskResponse returns out-of-band count update after deletion.
templ DeleteTaskResponse(columnID int64, count int) {
	<span id={ fmt.Sprintf("count-%d", columnID) } hx-swap-oob="true" class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5">
		{ intToStr(count) }
	</span>
}

// TaskDetailPane wraps the component for use in handlers.
templ TaskDetailPane(taskWithDeps model.TaskWithDependencies, orgID int64, projectID int64, comments []model.CommentThread, currentUser *model.User) {
	@components.TaskDetailPane(taskWithDeps, orgID, projectID, comments, currentUser)
}

// DependencySection wraps the component for use in handlers.
templ DependencySection(taskWithDeps model.TaskWithDependencies, orgID int64) {
	@components.DependencySection(taskWithDeps, orgID)
}

// MetadataSection wraps the component for use in handlers.
templ MetadataSection(taskID int64, orgID int64, projectID int64, metadata model.TaskMetadata) {
	@components.MetadataSection(taskID, orgID, projectID, metadata)
}

// TaskFieldUpdateResponse returns OOB updates for individual task fields (no full pane reload).
templ TaskFieldUpdateResponse(taskWithDeps model.TaskWithDependencies, orgID int64) {
	@components.TitleDisplay(taskWithDeps, orgID)
	@components.DescriptionDisplay(taskWithDeps, orgID)
	@components.AuthorDisplay(taskWithDeps, orgID)
	@components.DueDateDisplay(taskWithDeps, orgID)
	@components.DueDateForm(taskWithDeps, orgID)
	<!-- Update the task card on the kanban board -->
	<div
		id={ "task-" + fmt.Sprintf("%d", taskWithDeps.ID) }
		hx-swap-oob="true"
	>
		@components.TaskCard(taskWithDeps.Task, orgID)
	</div>
}

// ColumnUpdateResponse returns OOB updates for column badge and kanban columns (no full pane reload).
templ ColumnUpdateResponse(taskWithDeps model.TaskWithDependencies, orgID int64, oldColumnID int64, tasksByColumn map[int64][]model.Task, columns []model.ProjectColumn) {
	<!-- Update column badge -->
	@components.ColumnBadge(taskWithDeps, orgID, columns)
	if oldColumnID != taskWithDeps.ColumnID {
		<!-- Out-of-band: update old column task list -->
		<div
			id={ fmt.Sprintf("task-list-%d", oldColumnID) }
			class="sortable-column flex flex-col gap-2 min-h-[120px] p-2 rounded-lg bg-gray-100/50 border border-transparent transition-all duration-200"
			data-column-id={ strconv.FormatInt(oldColumnID, 10) }
			hx-swap-oob="true"
		>
			for _, task := range tasksByColumn[oldColumnID] {
				@components.TaskCard(task, orgID)
			}
		</div>
		<!-- Out-of-band: update old column count -->
		<span
			id={ fmt.Sprintf("count-%d", oldColumnID) }
			class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5"
			hx-swap-oob="true"
		>
			{ intToStr(len(tasksByColumn[oldColumnID])) }
		</span>
	}
	<!-- Out-of-band: update new column task list -->
	<div
		id={ fmt.Sprintf("task-list-%d", taskWithDeps.ColumnID) }
		class="sortable-column flex flex-col gap-2 min-h-[120px] p-2 rounded-lg bg-gray-100/50 border border-transparent transition-all duration-200"
		data-column-id={ strconv.FormatInt(taskWithDeps.ColumnID, 10) }
		hx-swap-oob="true"
	>
		for _, task := range tasksByColumn[taskWithDeps.ColumnID] {
			@components.TaskCard(task, orgID)
		}
	</div>
	<!-- Out-of-band: update new column count -->
	<span
		id={ fmt.Sprintf("count-%d", taskWithDeps.ColumnID) }
		class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5"
		hx-swap-oob="true"
	>
		{ intToStr(len(tasksByColumn[taskWithDeps.ColumnID])) }
	</span>
}
